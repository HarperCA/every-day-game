{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "event_edition_public_cache",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "edition_name", "registration_status", "event_level", "professions", "participation_format", "team_size_category", "fee_type", "registration_organization", "data_status", "system_validation", "manual_review", "sort_weight"],
  "properties": {
    "id": {"type": "string"},
    "event_id": {"type": "string"},
    "name": {"type": "string"},
    "edition_name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "organizer": {"type": "string"},
    "objective_tags": {"type": "array", "items": {"type": "string"}, "maxItems": 10},
    "participants": {"type": "string"},
    "eligibility": {"type": "string"},
    "format_and_rules": {"type": "string"},
    "team_size": {"type": "string"},
    "registration_method": {"type": "string"},
    "registration_url": {"type": "string", "format": "uri"},
    "fees": {"type": "string"},
    "track_name": {"type": "string"},
    "registration_status": {"enum": ["时间待公布", "即将报名", "报名中", "已截止"]},
    "registration_status_override": {"enum": ["时间待公布", "即将报名", "报名中", "已截止", null]},
    "event_level": {"enum": ["国家级", "省级/区域级", "其他/未明确"]},
    "professions": {"type": "array", "items": {"type": "string"}},
    "participation_format": {"enum": ["个人赛", "团队赛", "个人或团队均可", "暂未明确"]},
    "team_size_category": {"enum": ["1人", "2～3人", "4～5人", "6人及以上", "人数范围不固定", "暂未明确"]},
    "fee_type": {"enum": ["免费", "收费", "不同赛项费用不同", "暂未公布"]},
    "registration_organization": {"enum": ["自行报名", "学校统一报名", "两种方式均可", "需先校内选拔", "以赛区或学校通知为准", "暂未明确"]},
    "registration_start": {"type": ["string", "null"], "format": "date-time"},
    "registration_end": {"type": ["string", "null"], "format": "date-time"},
    "competition_start": {"type": ["string", "null"], "format": "date-time"},
    "competition_end": {"type": ["string", "null"], "format": "date-time"},
    "recommendation": {"enum": ["强烈推荐", "值得参加", "适合练手", "高难挑战", "谨慎报名", "信息不足"]},
    "recommendation_reasons": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
    "recommendation_suitable_for": {"type": "string"},
    "recommendation_limitations": {"type": "array", "items": {"type": "string"}, "maxItems": 10},
    "recommendation_preparation": {"type": "string"},
    "recommendation_confidence": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "source_type", "url"], "properties": {"id": {"type": "string"}, "source_type": {"type": "string"}, "url": {"type": "string", "format": "uri"}}}},
    "last_verified_at": {"type": "string", "format": "date-time"},
    "search_text": {"type": "string"},
    "sort_weight": {"type": "integer", "minimum": 0},
    "data_status": {"const": "published"},
    "system_validation": {"const": "passed"},
    "manual_review": {"const": "passed"},
    "reward_amount": {"type": ["number", "null"], "minimum": 0},
    "reward_tier": {"enum": ["无现金奖励", "万元以下", "1万-10万", "10万-50万", "50万以上", "暂未公布"]},
    "reward_highlights": {"type": "array", "items": {"enum": ["保研考研加分", "实习或直通面试", "就业绿色通道", "创业扶持", "国际交流", "证书荣誉", "实物奖品", "现金奖金"]}},
    "rewards": {"type": "string"},
    "participant_count": {"type": ["number", "null"], "minimum": 0},
    "participant_unit": {"enum": ["队", "人", "暂未公布"]},
    "scale_tier": {"enum": ["千人以下", "千人-1万", "1万-10万", "10万以上", "暂未公布"]},
    "participant_scale": {"type": "string"},
    "region": {"type": "string"},
    "lifecycle": {"enum": ["长期举办", "首届", "不定期", "疑似停办", "已停办", "暂未明确"]},
    "recognition": {"type": "array", "maxItems": 4, "items": {"type": "object", "required": ["path", "level", "evidence"], "additionalProperties": false, "properties": {"path": {"enum": ["保研考研", "求职就业", "出国留学", "创业融资"]}, "level": {"enum": ["高", "中", "低", "暂未明确"]}, "evidence": {"type": "string", "minLength": 1, "maxLength": 300, "description": "认可度的出处。没有出处的认可不可复核，会被丢弃。"}, "scope": {"type": "array", "items": {"type": "string", "maxLength": 40}, "maxItems": 8, "description": "具体岗位或方向。为空表示该路径下通用。"}}}, "description": "分路径分岗位的认可度。含金量的主要依据，权重高于现金奖金。"},
    "value_scores": {"type": "object", "additionalProperties": false, "properties": {"保研考研": {"type": "number", "minimum": 0, "maximum": 9}, "求职就业": {"type": "number", "minimum": 0, "maximum": 9}, "出国留学": {"type": "number", "minimum": 0, "maximum": 9}, "创业融资": {"type": "number", "minimum": 0, "maximum": 9}}, "description": "各目标路径下的推荐价值分。由认可度和非现金回报主导，现金奖金最多贡献 1 分。"}
  }
}
