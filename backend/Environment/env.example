# 新后端要设置的环境变量：这里只写名字和说明，不写值。
# 真实的值只放在服务器上（例如 systemd 服务文件的 Environment= 或单独的 env 文件，权限 600），不进仓库。
# 都不设也能跑测试：测试一律用假接口和内存里的库。

# ---- AI 总管（backend/美国/ai）----
# 密钥目录：每家一个文件，单行纯文本：deepseek.key、kimi.key、baidu.key、jev.key（OpenRouter 的密钥）；Codex 不用密钥
# （旧服务器上对应 .extract-key、.ai-key、.baidu-search-key、.openrouter-key）
AI_KEYS_DIR=
# 也可以直接给某一家的密钥（本地试跑方便；服务器上建议用上面的密钥目录）
# AI_KEY_DEEPSEEK=
# AI_KEY_KIMI=
# AI_KEY_BAIDU=
# AI_KEY_JEV=
# 用量库文件（默认 backend/美国/ai/usage.db）
AI_USAGE_DB=
# 百度搜索自动任务每天最多几次（默认 30；2026-11-03 起新旧并行期间设 15，和旧系统各一半）
BAIDU_DAILY_LIMIT=
# DeepSeek 接口地址（默认 https://api.deepseek.com）
AI_DEEPSEEK_BASE_URL=
# Kimi 会员通道地址（默认 https://api.kimi.com/coding/v1）
AI_KIMI_BASE_URL=
# Codex 命令行的位置（默认在 PATH 里找 codex）
CODEX_BIN=

# ---- 数据库总管（backend/美国/db）----
# 库文件所在目录；建议放在代码目录以外。美国：比赛库.db（默认 backend/美国/db/数据/）；北京：用户库.db（默认 backend/北京/db/数据/）
DB_DIR=

# ---- 定时器（backend/美国/定时）----
# 新后端 backend/ 的目录：定时器的 ExecStart 用它找脚本
BACKEND_DIR=

# ---- 维护（backend/美国/db/新维护）----
# 维护锁放哪（默认 backend/美国/db/数据/维护日志/）：每日新维护和后台多选的队列模式共用一把锁，不同时写比赛库
MAINTAIN_LOG_DIR=

# ---- 每晚流程（backend/美国/pipeline）----
# 每晚运行文件夹放哪（默认 backend/美国/pipeline/日志/），保留 90 天
PIPELINE_LOG_DIR=

# ---- 登录令牌（backend/共用/工具/令牌.mjs）----
# 北京签发、美国校验用的同一个密钥，两台服务器都要配、值必须一样；至少 32 个字符的随机串，不进仓库
SESSION_SIGNING_KEY=

# ---- 赛事助手（backend/美国/赛事助手）----
# 小服务器端口（默认 4320，只听本机，由 nginx 转发 /api/assistant）
ASSISTANT_PORT=
# 内容安全要用小程序的 AppID 和密钥换 access_token；密钥也可以放文件里，用 WECHAT_APPSECRET_FILE 指过去
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_APPSECRET_FILE=

# ---- 北京入口（backend/北京/入口）----
# 小服务器端口（默认 4330，只听本机，由 nginx 转发 xiaohuiworks.cn/api/）；也要配 SESSION_SIGNING_KEY、WECHAT_APPID、WECHAT_APPSECRET(_FILE)、DB_DIR
BEIJING_PORT=
# 网站对外提供海报文件夹的地址（没配就不给海报）；海报文件夹（默认 DB_DIR/海报/）
POSTER_BASE_URL=
POSTER_DIR=
# 订阅消息打开小程序的哪个版本：formal（正式版，默认）、trial（体验版）、developer（开发版）
MINIPROGRAM_STATE=
