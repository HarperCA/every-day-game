# 北京服务器的环境变量（放 /opt/competition-radar/beijing.env，不进仓库）。只写名字和说明，秘钥不写在这里。
DB_DIR=/opt/competition-radar/data
POSTER_DIR=/opt/competition-radar/posters
POSTER_BASE_URL=https://xiaohuiworks.cn/posters
# 头像（2026-11-12，小程序组队上传头像）：nginx 直接给 /avatars/，见 服务/用户数据/README.md
AVATAR_DIR=/opt/competition-radar/avatars
AVATAR_BASE_URL=https://xiaohuiworks.cn/avatars
WECHAT_APPID=
WECHAT_APPSECRET_FILE=/opt/competition-radar/secrets/wechat-appsecret
SYNC_SECRET_FILE=/opt/competition-radar/secrets/sync-secret
# 正式切换前关着发提醒（旧系统还在发，北京也发用户会收到两遍）；切换时删掉这行、停掉旧系统的发提醒
REMINDER_DISPATCH=off
BEIJING_PORT=4330
BEIJING_SYNC_PORT=4331
BEIJING_REVIEW_PORT=4333
# 美国接收用户数据的地址；美国部署好之前留空，用户数据同步的定时器也先不开
USER_SYNC_ENDPOINT=
USER_SYNC_STATE_FILE=/opt/competition-radar/data/用户数据同步状态.json
# 登录令牌密钥 SESSION_SIGNING_KEY 单独放 /opt/competition-radar/secrets/session.env（权限 600），和美国赛事助手用同一把
