# 竞赛雷达 北京收美国推来的公开比赛和海报（沟通/公开比赛同步/北京端.mjs，2026-11-03）。
# 只听本机 4331，nginx 把 /sync/public 转进来（只放美国服务器的 IP）。
[Unit]
Description=竞赛雷达 北京收公开比赛同步
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/competition-radar/backend
EnvironmentFile=/opt/competition-radar/beijing.env
ExecStart=/usr/bin/node --preserve-symlinks-main /opt/competition-radar/backend/沟通/公开比赛同步/北京端.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0022

[Install]
WantedBy=multi-user.target
