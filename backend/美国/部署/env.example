# 美国服务器上新系统的环境变量（放 /etc/competition-radar/env，权限 600，不进仓库）。只写名字和值的样子，秘钥都是文件路径。
# 新系统自带 Node 22（/opt/competition-radar/node），系统的 Node 20 留给旧服务
PATH=/opt/competition-radar/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# backend 是软链接（指当前版本），不带这个 Node 会把入口解析成真实路径，“直接运行”那段不执行
NODE_OPTIONS=--preserve-symlinks-main
BACKEND_DIR=/opt/competition-radar/backend
DB_DIR=/opt/competition-radar/data
POSTER_DIR=/opt/competition-radar/posters
AI_KEYS_DIR=/opt/competition-radar/secrets/ai
AI_USAGE_DB=/opt/competition-radar/data/ai-usage.db
PIPELINE_LOG_DIR=/opt/competition-radar/logs/pipeline
MAINTAIN_LOG_DIR=/opt/competition-radar/logs/maintain
# 美国读不到网页时改由北京读（db/维护/北京读网页.mjs）；不配就只从美国读。密钥是只能运行读网页命令的专用密钥
BEIJING_READER_HOST=
BEIJING_READER_KEY=
SYNC_ENDPOINT=https://xiaohuiworks.cn/sync/public
SYNC_SECRET_FILE=/opt/competition-radar/secrets/sync-secret
SYNC_STATE_FILE=/opt/competition-radar/data/公开比赛同步状态.json
SYNC_REVIEW_ENDPOINT=https://xiaohuiworks.cn/sync/review
WECHAT_APPID=
WECHAT_APPSECRET_FILE=/opt/competition-radar/secrets/wechat-appsecret
# 新后台的口令（独立文件，权限 600）
ADMIN_TOKEN_FILE=/opt/competition-radar/secrets/admin-token
# 新旧并行期间百度每天新旧各 15 次（旧系统的定时任务也设了 15）；切换后删掉这行，回到默认 30
BAIDU_DAILY_LIMIT=15
ASSISTANT_PORT=4320
USER_SYNC_PORT=4332
# 登录令牌密钥 SESSION_SIGNING_KEY 单独放 /opt/competition-radar/secrets/session.env（600），和北京同一把
