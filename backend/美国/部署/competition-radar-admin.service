# 竞赛雷达 新后台（美国/后台/服务.mjs，2026-11-03）。只听本机，经 SSH 隧道看：ssh -L 4318:127.0.0.1:4318 daily-contest，然后开 http://localhost:4318。还没有管理员口令，所以不经 nginx 对外。
[Unit]
Description=竞赛雷达 新后台（只听本机 4318）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/competition-radar/env
EnvironmentFile=/opt/competition-radar/secrets/session.env
Environment=PORT=4318
ExecStart=/opt/competition-radar/node/bin/node /opt/competition-radar/backend/美国/后台/服务.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
