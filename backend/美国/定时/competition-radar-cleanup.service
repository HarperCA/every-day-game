# 竞赛雷达 回收站每日清理（每天 0:30）
# 彻底删除标记删除超过 30 天的比赛和届次，删掉超过 30 天的拒过的网址。环境变量（BACKEND_DIR、DB_DIR、AI_KEYS_DIR、PIPELINE_LOG_DIR、MAINTAIN_LOG_DIR、PATH 里要有 Node 22）
# 写在服务器上的 /etc/competition-radar/env（权限 600，不进仓库），说明见同目录 README.md。
[Unit]
Description=竞赛雷达 回收站每日清理（每天 0:30）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/competition-radar/env
ExecStart=/usr/bin/env node ${BACKEND_DIR}/美国/后台/每日清理.mjs
