# 竞赛雷达 每晚寻找流程（每天 1:00）
# 流程跑完通常几个小时；同一时间只跑一次由流程自己的锁保证。环境变量（BACKEND_DIR、DB_DIR、AI_KEYS_DIR、PIPELINE_LOG_DIR、MAINTAIN_LOG_DIR、PATH 里要有 Node 22）
# 写在服务器上的 /etc/competition-radar/env（权限 600，不进仓库），说明见同目录 README.md。
[Unit]
Description=竞赛雷达 每晚寻找流程（每天 1:00）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/competition-radar/env
ExecStart=/usr/bin/env node ${BACKEND_DIR}/美国/pipeline/run.mjs
