[Unit]
Description=竞赛雷达每日归档扫描（报名已截止的赛事撤下公开缓存，估算下一届时间）
After=daily-contest-api.service

[Service]
# 服务器在美国、没有 IPv6：Node 默认只等 250ms 就放弃 IPv4 改试 IPv6，连国内站点会超时，放宽到 2 秒
Environment=NODE_OPTIONS=--network-family-autoselection-attempt-timeout=2000
Type=oneshot
ExecStart=/bin/bash /opt/daily-contest/scheduled-archive.sh
StandardOutput=append:/var/log/daily-contest-archive.log
StandardError=append:/var/log/daily-contest-archive.log
