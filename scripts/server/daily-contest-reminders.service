[Unit]
Description=竞赛雷达定时提醒推送（替代失效的 CloudBase 定时触发器）
After=daily-contest-api.service

[Service]
# 服务器在美国、没有 IPv6：Node 默认只等 250ms 就放弃 IPv4 改试 IPv6，连国内站点会超时，放宽到 2 秒
Environment=NODE_OPTIONS=--network-family-autoselection-attempt-timeout=2000
Type=oneshot
ExecStart=/bin/bash /opt/daily-contest/scheduled-reminders.sh
StandardOutput=append:/var/log/daily-contest-reminders.log
StandardError=append:/var/log/daily-contest-reminders.log
