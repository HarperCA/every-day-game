[Unit]
Description=竞赛雷达后端（自有服务器，替代 CloudBase 云函数）
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/daily-contest/server
# 只监听本机：对外由 nginx 反代，Node 服务本身不暴露端口
Environment=PORT=8787
Environment=HOST=127.0.0.1
Environment=DB_FILE=/opt/daily-contest/server/data/app.db
Environment=FUNCTIONS_DIR=/opt/daily-contest/functions
# 密钥从文件读进环境变量，不写在这个文件里（这个文件权限没那么严）
ExecStart=/bin/bash -c 'export ADMIN_TOKEN=$(cat /opt/daily-contest/.admin-token) && export AI_API_KEY=$(cat /opt/daily-contest/.extract-key) && export AI_BASE_URL=https://api.deepseek.com && export AI_MODEL=deepseek-chat && exec /usr/bin/node src/index.mjs'
Restart=always
RestartSec=3
StandardOutput=append:/var/log/daily-contest-api.log
StandardError=append:/var/log/daily-contest-api.log

[Install]
WantedBy=multi-user.target
