[Unit]
Description=竞赛雷达后端（自有服务器，替代 CloudBase 云函数）
After=network.target

[Service]
# 服务器在美国、没有 IPv6：Node 默认只等 250ms 就放弃 IPv4 改试 IPv6，连国内站点会超时，放宽到 2 秒
Environment=NODE_OPTIONS=--network-family-autoselection-attempt-timeout=2000
Type=simple
WorkingDirectory=/opt/daily-contest/server
# 只监听本机：对外由 nginx 反代，Node 服务本身不暴露端口
Environment=PORT=8787
Environment=HOST=127.0.0.1
Environment=DB_FILE=/opt/daily-contest/server/data/app.db
Environment=FUNCTIONS_DIR=/opt/daily-contest/functions
Environment=KIMI_AGENT_SEARCH_MODULE=/opt/daily-contest/search-engines.mjs
# 密钥从文件读进环境变量，不写在这个文件里（这个文件权限没那么严）。
# 审核（AI_*）走 .ai-key，用真正的 Kimi；批量抽取是另一条独立的路径
# （run-extract.mjs 自己读 .extract-key），不受这里影响，继续用 DeepSeek——
# 抽取是突发型负载，按量计费比 Kimi 会员制的 5 小时窗口配额更合适。
ExecStart=/bin/bash -c 'export WECHAT_APPID=wxb71625ff1404e4e5 && export WECHAT_APPSECRET_FILE=/opt/daily-contest/.wechat-appsecret && export DISPATCH_SECRET=$(cat /opt/daily-contest/.dispatch-secret) && export ADMIN_TOKEN=$(cat /opt/daily-contest/.admin-token) && export AI_API_KEY=$(cat /opt/daily-contest/.ai-key) && export ASSISTANT_AI_API_KEY=$(cat /opt/daily-contest/.extract-key) && export ASSISTANT_TESTERS_FILE=/opt/daily-contest/assistant-testers.txt && export AI_BASE_URL=https://api.kimi.com/coding/v1 && export AI_MODEL=kimi-for-coding && exec /usr/bin/node src/index.mjs'
Restart=always
RestartSec=3
StandardOutput=append:/var/log/daily-contest-api.log
StandardError=append:/var/log/daily-contest-api.log

[Install]
WantedBy=multi-user.target
