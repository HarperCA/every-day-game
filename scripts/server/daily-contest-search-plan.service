[Unit]
Description=竞赛雷达次日搜索计划（按 60/25/15 把当天搜索额度分给三条路线，每条查询附理由）
After=daily-contest-api.service

[Service]
# 服务器在美国、没有 IPv6：Node 默认只等 250ms 就放弃 IPv4 改试 IPv6，连国内站点会超时，放宽到 2 秒
Environment=NODE_OPTIONS=--network-family-autoselection-attempt-timeout=2000
Type=oneshot
WorkingDirectory=/opt/daily-contest
ExecStart=/usr/bin/node /opt/daily-contest/search-plan.mjs
StandardOutput=append:/var/log/daily-contest-search-plan.log
StandardError=append:/var/log/daily-contest-search-plan.log
