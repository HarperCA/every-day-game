[Unit]
Description=竞赛雷达路线台账（按路线和查询词统计搜索投入与合格新增，给次日搜索计划用）
After=daily-contest-api.service

[Service]
# 服务器在美国、没有 IPv6：Node 默认只等 250ms 就放弃 IPv4 改试 IPv6，连国内站点会超时，放宽到 2 秒
Environment=NODE_OPTIONS=--network-family-autoselection-attempt-timeout=2000
Type=oneshot
WorkingDirectory=/opt/daily-contest
ExecStart=/usr/bin/node /opt/daily-contest/route-ledger.mjs
StandardOutput=append:/var/log/daily-contest-route-ledger.log
StandardError=append:/var/log/daily-contest-route-ledger.log
