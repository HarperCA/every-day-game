# 赛事列表仍可使用本地开发预览数据；管理后台和用户数据同步使用 CloudBase。
VITE_DATA_MODE=cloudbase
VITE_CLOUDBASE_ENV_ID=daily-contest-dev-d8dbbhc653e221
VITE_API_BASE_URL=http://localhost:8788

# 仅在服务端部署环境配置，严禁把 AppSecret、管理员口令或 AI 密钥写入小程序源码。
CLOUDBASE_ENV_ID=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 仅配置到 adminData 云函数环境变量，绝不能以 VITE_ 前缀写入前端。
ADMIN_TOKEN=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=kimi-k2.5
AI_BASE_URL=https://api.moonshot.cn/v1
