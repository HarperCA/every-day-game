/* 全局颜色变量（2026-10 界面改版）：各页面统一从这里取色，不再各写各的 */
page {
  --bg: #f4f7fc;
  --surface: #ffffff;
  --ink: #172033;      /* 正文 */
  --ink2: #4a5868;     /* 次要文字 */
  --muted: #8592a3;    /* 最弱的文字 */
  --line: #e6ebf1;     /* 分隔线、边框 */
  --chip: #f1f4f8;     /* 浅灰底 */
  --accent: #1765d9;   /* 主色 */
  --accent-soft: #e8f0fd;
  --amber: #c26a00;
  --star: #f5a623;
  /* 五档推荐等级：强烈推荐、值得参加、适合练手、高难挑战、谨慎报名 */
  --r1: #1765d9; --r2: #1f8a55; --r3: #0f7f8a; --r4: #6d4fc2; --r5: #b8501b;
  background: var(--bg); color: var(--ink); font-size: 28rpx;
}
button { border-radius: 16rpx; }
.page { min-height: 100vh; padding: 24rpx 24rpx 48rpx; box-sizing: border-box; }
.card { background: #fff; border: 1rpx solid #e6ebf1; border-radius: 22rpx; box-shadow: 0 6rpx 18rpx rgba(32, 68, 92, .05); }
.muted { color: #6b778c; }
.section-title { font-size: 32rpx; font-weight: 700; margin: 34rpx 0 18rpx; }
.primary { background: #1765d9 !important; color: #fff !important; }

/* 报名状态：小圆点 + 文字（首页、收藏共用） */
.st { display: inline-flex; align-items: center; gap: 10rpx; font-weight: 600; white-space: nowrap; }
.st::before { content: ""; width: 14rpx; height: 14rpx; border-radius: 50%; background: currentColor; }
.st.status-open { color: var(--accent); }
.st.status-upcoming { color: var(--amber); }
.st.status-pending, .st.status-closed { color: var(--muted); }

/* 推荐等级文字颜色（首页、收藏、详情共用） */
.rec { font-weight: 600; white-space: nowrap; }
.rec.r1 { color: var(--r1); } .rec.r2 { color: var(--r2); } .rec.r3 { color: var(--r3); } .rec.r4 { color: var(--r4); } .rec.r5 { color: var(--r5); }

/* 比赛卡片（首页、收藏共用）：两行——名称和星标；状态、截止、推荐等级 */
.ccard { background: var(--surface); border-radius: 32rpx; padding: 30rpx 24rpx 28rpx 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 4rpx rgba(23, 32, 51, .05), 0 12rpx 32rpx -20rpx rgba(23, 32, 51, .18); }
.ccard-r1 { display: flex; align-items: flex-start; gap: 16rpx; }
.ccard-name { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 600; line-height: 1.5; letter-spacing: .4rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.ccard-star { flex: none; width: 60rpx; height: 60rpx; margin: -8rpx -8rpx -12rpx 0; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 38rpx; line-height: 1; }
.ccard-star.on { color: var(--star); }
.ccard-r2 { display: flex; align-items: center; gap: 28rpx; margin-top: 18rpx; font-size: 26rpx; color: var(--ink2); padding-right: 8rpx; }
.ccard-dl { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ccard-dl.arch { color: var(--amber); }
.ccard-r2 .rec { font-size: 25rpx; }

/* 双列卡片（2026-10 淘宝风格改版，首页、收藏页共用，模板在 templates/poster-card.wxml）：
   整齐网格，每行两张顶部对齐、一样高；没海报时是文字封面（完整赛事名称，颜色按专业大类） */
.card-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:16rpx; }
.pcard { display:flex; flex-direction:column; background:var(--surface); border-radius:16rpx; overflow:hidden; box-shadow:0 2rpx 4rpx rgba(23,32,51,.04), 0 8rpx 24rpx -12rpx rgba(23,32,51,.16); }
.pcard.ended { opacity:.72; }
.pcard-poster { position:relative; width:100%; height:193rpx; background:var(--accent-soft); }
.pcard-img { display:block; width:100%; height:100%; }
.cover { position:relative; box-sizing:border-box; width:100%; height:100%; padding:18rpx 20rpx; display:flex; flex-direction:column; justify-content:space-between; overflow:hidden; color:#fff; }
.cover::before, .cover::after { content:""; position:absolute; border-radius:50%; background:rgba(255,255,255,.12); }
.cover::before { width:200rpx; height:200rpx; right:-60rpx; top:-80rpx; }
.cover::after { width:120rpx; height:120rpx; right:40rpx; bottom:-70rpx; background:rgba(255,255,255,.08); }
.cover-kicker { position:relative; align-self:flex-start; max-width:70%; padding:2rpx 12rpx; border-radius:6rpx; background:rgba(255,255,255,.2); font-size:19rpx; line-height:1.5; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.cover-title { position:relative; font-size:28rpx; font-weight:700; line-height:1.3; letter-spacing:1rpx; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; word-break:break-all; text-shadow:0 2rpx 6rpx rgba(0,0,0,.12); }
.cover-blue { background:linear-gradient(135deg, #2f7cf0, #1450b8); }
.cover-teal { background:linear-gradient(135deg, #1aa2a8, #0d6f86); }
.cover-green { background:linear-gradient(135deg, #34a56f, #1b7a52); }
.cover-orange { background:linear-gradient(135deg, #f29b38, #d2621c); }
.cover-purple { background:linear-gradient(135deg, #8a6ae0, #5a3fb5); }
.cover-rose { background:linear-gradient(135deg, #e5677d, #b8405f); }
.cover-indigo { background:linear-gradient(135deg, #5b6fd8, #3946a8); }
.pcard-star { position:absolute; top:10rpx; right:10rpx; width:52rpx; height:52rpx; border-radius:50%; background:rgba(255,255,255,.88); color:var(--muted); font-size:32rpx; line-height:52rpx; text-align:center; }
.pcard-star.on { color:var(--star); }
.pcard-body { flex:1; padding:16rpx 18rpx 20rpx; display:flex; flex-direction:column; gap:12rpx; }
.pcard-name { min-height:82rpx; font-size:28rpx; font-weight:600; line-height:1.45; color:var(--ink); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; word-break:break-all; }
.pcard-tags { display:flex; flex-wrap:wrap; gap:8rpx; }
.pcard-status, .pcard-level, .pcard-rec { padding:4rpx 12rpx; border-radius:8rpx; font-size:21rpx; font-weight:600; line-height:1.4; }
.pcard-status.status-open { color:var(--accent); background:var(--accent-soft); }
.pcard-status.status-upcoming { color:var(--amber); background:#fdf1e2; }
.pcard-status.status-pending, .pcard-status.status-closed { color:var(--muted); background:var(--chip); }
.pcard-level { color:var(--ink2); background:var(--chip); }
.pcard-rec { background:var(--chip); }
.pcard-dl { font-size:23rpx; color:var(--ink2); font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.pcard-dl.urgent { color:#d2481c; }
.pcard-dl.muted { color:var(--muted); font-weight:400; }
.pcard-gone { font-size:23rpx; line-height:1.5; color:var(--muted); }
.pcard-since { font-size:21rpx; color:var(--muted); }
