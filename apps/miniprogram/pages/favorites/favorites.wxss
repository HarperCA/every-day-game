.page-heading { margin: 8rpx 4rpx 26rpx; }
.page-title { font-size: 42rpx; line-height: 1.3; font-weight: 750; color: #1f3557; }
.page-subtitle { color: #718096; font-size: 24rpx; margin-top: 8rpx; }
.favorite-card { padding: 24rpx; margin-bottom: 18rpx; }
.card-head { display: flex; justify-content: space-between; align-items: center; }
.status-row { display: flex; align-items: center; gap: 10rpx; }
.status { color: #fff; background: #60748b; border-radius: 999rpx; padding: 7rpx 16rpx; font-size: 23rpx; font-weight: 650; }
.status-open { background: #1765d9; }
.status-upcoming { background: #2768b2; }
.status-pending { background: #7b61a8; }
.status-closed { background: #7a8492; }
.ended-mark { color: #7a8492; background: #eef1f4; border-radius: 999rpx; padding: 7rpx 13rpx; font-size: 21rpx; }
.competition-name { font-size: 32rpx; font-weight: 750; line-height: 1.45; margin-top: 18rpx; }
.edition { color: #65748a; font-size: 24rpx; margin-top: 7rpx; }
.tags { display: flex; gap: 10rpx; flex-wrap: wrap; margin: 18rpx 0; }
.tag { background: #eef4ff; color: #315b96; border-radius: 8rpx; padding: 6rpx 12rpx; font-size: 21rpx; }
.recommendation { display: flex; gap: 12rpx; color: #244b83; font-weight: 700; }
.card-footer { border-top: 1rpx solid #edf0f4; margin-top: 18rpx; padding-top: 16rpx; display: flex; justify-content: space-between; align-items: flex-end; gap: 18rpx; }
.deadline { color: #27364a; font-size: 24rpx; }
.favorite-date { color: #8995a7; font-size: 21rpx; margin-top: 7rpx; }
.cancel-button { flex-shrink: 0; margin: 0; background: #fff !important; color: #66758a !important; border: 1rpx solid #cfd7e1; font-size: 22rpx; }
.state { text-align: center; padding: 70rpx 36rpx; }
.state-title { font-size: 31rpx; font-weight: 700; margin-bottom: 12rpx; }
.state .muted { line-height: 1.65; }
.empty-icon { color: #7ba6e7; font-size: 88rpx; line-height: 1; margin-bottom: 24rpx; }
.find-button { margin-top: 30rpx; width: 330rpx; }
.retry { margin-top: 24rpx; color: #1765d9 !important; background: #eaf2ff !important; }
.skeleton { padding: 24rpx; margin-bottom: 18rpx; }
.skeleton view { height: 24rpx; background: #edf1f4; border-radius: 8rpx; margin: 16rpx 0; }
.skeleton view:first-child { width: 38%; }
.skeleton view:last-child { width: 70%; }
