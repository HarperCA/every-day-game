<!-- 我的收藏（2026-10 改版）：卡片和首页一样（共用 templates/poster-card.wxml）；右上角实心星标 = 取消收藏 -->
<import src="/templates/poster-card.wxml" />
<view class="fav-page">
  <view class="count" wx:if="{{!loginRequired && !error && items.length}}">共 {{items.length}} 场</view>

  <view wx:if="{{loginRequired}}" class="state"><view class="state-title">登录后查看收藏</view><view class="state-sub">收藏与当前微信账号关联。</view><button class="state-btn" bindtap="requestWechatLogin">微信登录</button></view>
  <view wx:elif="{{loading && items.length === 0}}">
    <view class="skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"><view></view><view></view></view>
  </view>
  <view wx:elif="{{error}}" class="state">
    <view class="state-title">收藏加载失败</view>
    <view class="state-sub">{{error}}</view>
    <button class="state-btn" bindtap="retry">重新加载</button>
  </view>
  <view wx:elif="{{items.length === 0}}" class="state">
    <view class="empty-icon">☆</view>
    <view class="title-row"><text class="state-title">还没有收藏赛事</text><text class="qmark {{emptyHelp ? 'on' : ''}}" bindtap="toggleEmptyHelp" role="button" aria-label="说明">?</text></view>
    <view wx:if="{{emptyHelp}}" class="tip">在首页或详情页点星标，就能在这里快速找到。</view>
    <button class="state-btn" bindtap="goFindCompetition">去发现赛事</button>
  </view>

  <view wx:else class="card-grid">
    <template is="poster-card" wx:for="{{items}}" wx:key="id" data="{{item, index}}" />
  </view>
</view>
