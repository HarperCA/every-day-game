.info-page{padding-bottom:44rpx}.hero{padding:36rpx 30rpx;background:linear-gradient(145deg,#ffffff,#eff5ff)}.title{margin-top:0;color:#172033;font-size:42rpx;font-weight:800}.section{margin-top:20rpx;padding:28rpx}.section-title{display:flex;align-items:center;gap:12rpx;margin-bottom:16rpx;color:#1e293b;font-size:29rpx;font-weight:800}.paragraph{color:#526172;font-size:25rpx;line-height:1.75}.paragraph+.paragraph{margin-top:12rpx}.bullet{display:flex;align-items:flex-start;gap:14rpx;color:#526172;font-size:25rpx;line-height:1.65;padding:7rpx 0}.bullet-dot{flex:none;width:10rpx;height:10rpx;margin-top:16rpx;border-radius:50%;background:#1765d9}.level-dot{width:16rpx;height:16rpx;border-radius:50%;background:#1765d9}.level-strong .level-dot{background:#174a9e}.level-worth .level-dot{background:#2465ba}.level-practice .level-dot{background:#4a81c7}.level-challenge .level-dot{background:#7199c8}.level-caution .level-dot{background:#9aacc6}.level-insufficient .level-dot{background:#8b96a6}
.section-title-text{flex:1}
.cooperation-contact{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:18rpx}.cooperation-contact button{flex:none;margin:0;color:#1765d9;background:#eff5ff;font-size:24rpx}
.info-page .section-title{margin:0 0 16rpx}
.section-title-collapsible{min-height:48rpx}
.section-title-collapsible{position:relative;justify-content:center}
.section-title-collapsible .section-title-text{flex:none;padding:0 36rpx;text-align:center}
.section-title-collapsible .level-dot{position:absolute;left:0}
.section-title-collapsible .section-chevron{position:absolute;right:0}
.info-page .section-collapsed .section-title{margin-bottom:0}
.section-chevron{flex:none;width:14rpx;height:14rpx;margin-right:8rpx;border-right:3rpx solid #8292a7;border-bottom:3rpx solid #8292a7;transform:rotate(45deg);transition:transform .2s}
.section-chevron-open{transform:rotate(-135deg)}
.other-link{position:relative;display:flex;align-items:center;justify-content:center;min-height:52rpx;color:#1e293b;font-size:29rpx;font-weight:800;text-align:center}
.other-arrow{position:absolute;right:0;color:#8292a7;font-size:42rpx;font-weight:400;line-height:1}
