.info-page{padding-bottom:44rpx}.hero{padding:36rpx 30rpx;background:linear-gradient(145deg,#ffffff,#edf8f8)}.eyebrow{color:#087e8b;font-size:22rpx;font-weight:700;letter-spacing:3rpx}.title{margin-top:10rpx;color:#172033;font-size:42rpx;font-weight:800}.subtitle{margin-top:16rpx;color:#64748b;font-size:26rpx;line-height:1.7}.notice{display:flex;gap:18rpx;margin:22rpx 0;padding:24rpx;border:1rpx solid #efd9a0;border-radius:18rpx;background:#fff9e9;color:#715719;font-size:24rpx;line-height:1.65}.notice-mark{display:flex;flex:none;align-items:center;justify-content:center;width:34rpx;height:34rpx;border-radius:50%;background:#e5a82f;color:#fff;font-weight:800}.section{margin-top:20rpx;padding:28rpx}.section-title{display:flex;align-items:center;gap:12rpx;margin-bottom:16rpx;color:#1e293b;font-size:29rpx;font-weight:800}.paragraph{color:#526172;font-size:25rpx;line-height:1.75}.paragraph+.paragraph{margin-top:12rpx}.bullet{display:flex;align-items:flex-start;gap:14rpx;color:#526172;font-size:25rpx;line-height:1.65;padding:7rpx 0}.bullet-dot{flex:none;width:10rpx;height:10rpx;margin-top:16rpx;border-radius:50%;background:#0c8996}.level-dot{width:16rpx;height:16rpx;border-radius:50%;background:#0c8996}.level-strong .level-dot{background:#0a8f69}.level-worth .level-dot{background:#1685a8}.level-practice .level-dot{background:#6d8e35}.level-challenge .level-dot{background:#7957a8}.level-caution .level-dot{background:#d47c22}.level-insufficient .level-dot{background:#8b96a6}.footer-note{text-align:center;color:#94a3b8;font-size:22rpx;padding:34rpx 0 10rpx}
