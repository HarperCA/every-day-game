<view class="page info-page">
  <view class="hero card">
    <view class="eyebrow">使用说明</view>
    <view class="title">{{page.title}}</view>
    <view class="subtitle">{{page.subtitle}}</view>
  </view>

  <view class="notice" wx:if="{{page.notice}}">
    <view class="notice-mark">!</view>
    <text>{{page.notice}}</text>
  </view>

  <view class="section card {{item.level ? 'level-' + item.level : ''}}" wx:for="{{page.sections}}" wx:key="title">
    <view class="section-title">
      <view class="level-dot" wx:if="{{item.level}}"></view>
      <text>{{item.title}}</text>
    </view>
    <view class="paragraph" wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this">{{paragraph}}</view>
    <view class="bullet" wx:for="{{item.items}}" wx:for-item="point" wx:key="*this">
      <view class="bullet-dot"></view>
      <text>{{point}}</text>
    </view>
  </view>

  <view class="footer-note">请以赛事官方最新通知为准</view>
</view>
