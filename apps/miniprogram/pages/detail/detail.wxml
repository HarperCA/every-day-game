<view class="page" wx:if="{{item}}">
  <view class="summary card">
    <view class="status">{{item.registrationStatus}}</view>
    <view class="title">{{item.name}}</view>
  </view>
  <view class="section-title">关键时间</view>
  <view class="info card"><view><text>报名开始</text><text>{{item.registrationStartDate || '待公布'}}</text></view><view><text>报名截止</text><text>{{item.registrationEndDate ? item.registrationEndDate + (item.registrationEndNote ? '（' + item.registrationEndNote + '）' : '') : (item.registrationEndNote || '待公布')}}</text></view><view><text>比赛开始</text><text>{{item.competitionStartDate || '待公布'}}</text></view><view><text>比赛结束</text><text>{{item.competitionEndDate || '待公布'}}</text></view>
    <view wx:if="{{item.timeNote}}" class="time-note"><text>时间说明</text><text class="time-note-body">{{item.timeNote}}</text></view>
    <view wx:if="{{item.dataStatus === 'archived' && item.nextEditionEstimateDate}}" class="next-edition">下一届预计：{{item.nextEditionEstimateDate}} 前后（按上一届时间推算，以官方通知为准）</view>
  </view>
  <view wx:if="{{item.dataStatus === 'archived'}}" class="timing-warning card timing-unverified">
    <view class="timing-head">这届已归档，报名已截止</view>
  </view>
  <view wx:if="{{item.schoolTimingDependent}}" class="timing-warning card timing-{{item.timingReliability}}">
    <view wx:if="{{item.timingReliability !== 'school_controlled'}}" class="timing-head">以上日期未经确认</view>
    <view class="timing-note">{{item.schoolTimingNote}}</view>
  </view>
  <view class="quick-actions">
    <button class="reminder-action" bindtap="openReminderPanel">{{reminderCount ? '管理提醒 · ' + reminderCount + '项' : '设置提醒'}}</button>
    <button class="ghost {{isFavorite ? 'favorited' : ''}}" bindtap="favorite">{{isFavorite ? '已收藏 · 点击取消' : '收藏赛事'}}</button>
  </view>
  <button class="primary action" disabled="{{!item.registrationUrlUsable}}" bindtap="copyRegistrationUrl">{{item.registrationUrlUsable ? '复制官方报名链接' : '官方报名链接待更新'}}</button>
  <button class="secondary action" bindtap="feedback">信息纠错</button>
  <view class="recommendation card" wx:if="{{item.recommendationLevel}}">
    <view class="recommendation-head" bindtap="toggleRecommendation" role="button" aria-expanded="{{recommendationExpanded}}"><text>{{item.recommendationLevel}}</text><text class="recommendation-toggle">{{recommendationExpanded ? '收起 ▲' : '展开 ▼'}}</text></view>
    <view hidden="{{!recommendationExpanded}}" class="recommendation-body">
      <view class="label">适合对象</view><view>{{item.recommendation.suitable_for || '暂无说明'}}</view>
      <view class="label">推荐理由</view><view wx:if="{{!item.recommendation.reasons.length}}">暂无说明</view><view class="bullet" wx:for="{{item.recommendation.reasons}}" wx:for-item="reason" wx:key="*this">· {{reason}}</view>
      <view class="label">限制条件</view><view wx:if="{{!item.recommendation.limitations.length}}">暂无说明</view><view class="bullet" wx:for="{{item.recommendation.limitations}}" wx:for-item="limitation" wx:key="*this">· {{limitation}}</view>
      <view class="label">准备建议</view><view>{{item.recommendation.preparation || '暂无说明'}}</view>
      <view class="confidence">推荐可信度：{{item.recommendation.confidence || '待核验'}}</view>
    </view>
  </view>
  <view class="fold-heading" bindtap="toggleRules" role="button" aria-expanded="{{rulesExpanded}}"><text>参赛与规则</text><text class="fold-action">{{rulesExpanded ? '收起 ▲' : '展开 ▼'}}</text></view>
  <view wx:if="{{rulesExpanded}}" class="text-card card"><view class="label">{{item.showEligibility ? '参赛对象' : '参赛对象与资格'}}</view><view class="{{item.fieldText.participants === '信息不足' ? 'insufficient' : ''}}">{{item.fieldText.participants}}</view><block wx:if="{{item.showEligibility}}"><view class="label">参赛资格</view><view>{{item.fieldText.eligibility}}</view></block><view class="label">团队人数</view><view class="{{item.fieldText.teamSize === '信息不足' ? 'insufficient' : ''}}">{{item.fieldText.teamSize}}</view><view class="label">赛项/组别</view><view>{{item.track.name}}</view><view class="label">比赛形式与作品要求</view><view class="{{item.fieldText.formatAndRules === '信息不足' ? 'insufficient' : ''}}">{{item.fieldText.formatAndRules}}</view><block wx:if="{{item.rewardHighlights.length || item.fieldText.rewards !== '信息不足'}}"><view class="label">奖项设置</view><view wx:if="{{item.rewardHighlights.length}}" class="tag-row reward-tags"><text wx:for="{{item.rewardHighlights}}" wx:for-item="highlight" wx:key="*this">{{highlight}}</text></view><view wx:if="{{item.fieldText.rewards !== '信息不足'}}" class="rewards-text">{{item.rewards}}</view></block><view class="label">报名费及其他费用</view><view class="{{item.fieldText.fees === '信息不足' ? 'insufficient' : ''}}">{{item.fieldText.fees}}</view></view>
  <view class="fold-heading" bindtap="toggleOfficialInfo" role="button" aria-expanded="{{officialInfoExpanded}}"><text>官方信息</text><text class="fold-action">{{officialInfoExpanded ? '收起 ▲' : '展开 ▼'}}</text></view>
  <view wx:if="{{officialInfoExpanded}}" class="text-card card">
    <view class="edition-meta"><view><text>赛事年份</text><text>{{item.editionYear || '未明确'}}</text></view><view><text>第几届</text><text>{{item.editionOrdinal || '未明确'}}</text></view></view>
    <view class="label">赛事级别与标签</view>
    <view class="tag-row"><text>{{item.eventLevel}}</text><text wx:for="{{item.objectiveTags}}" wx:key="*this">{{item}}</text></view>
    <view class="label">主办单位</view><view class="{{item.fieldText.organizer === '信息不足' ? 'insufficient' : ''}}">{{item.fieldText.organizer}}</view>
    <view class="label">官方报名方式</view><view class="{{item.fieldText.registrationMethod === '信息不足' ? 'insufficient' : ''}}">{{item.fieldText.registrationMethod}}</view>
  </view>
  <view class="disclaimer">是否计入综测、保研或校内竞赛认定，请以本校最新文件为准。平台推荐不代表学校、主办单位或官方认定。</view>
  <view wx:if="{{reminderPanelVisible}}" class="reminder-mask" bindtap="closeReminderPanel" catchtouchmove="blockPanelTap">
    <view class="reminder-sheet" catchtap="blockPanelTap">
      <view class="sheet-handle"></view>
      <view class="sheet-head"><view><view class="sheet-title">设置提醒</view><view class="sheet-subtitle">选择提醒事件和具体提醒时间</view></view><text class="sheet-close" bindtap="closeReminderPanel">×</text></view>
      <scroll-view class="sheet-scroll" scroll-y>
        <view class="reminder-section">
          <view class="reminder-label">提醒事件</view>
          <view class="event-options"><view class="event-option {{reminderEventType === item.value ? 'option-active' : ''}} {{item.available ? '' : 'option-disabled'}}" wx:for="{{reminderEvents}}" wx:key="value" data-value="{{item.value}}" bindtap="selectReminderEvent"><view>{{item.label}}</view><text>{{item.targetText}}</text></view></view>
        </view>
        <view class="reminder-section">
          <view class="reminder-label">自定义时间</view>
          <view class="custom-row"><picker mode="date" value="{{customDate}}" start="{{customMinDate}}" bindchange="onCustomDateChange"><view>{{customDate || '选择日期'}}</view></picker><picker mode="time" value="{{customTime}}" bindchange="onCustomTimeChange"><view>{{customTime}}</view></picker></view>
        </view>
        <view class="reminder-tip">每次选择一个提醒时间，点击保存后直接申请微信通知授权，同意后自动保存。</view>
      </scroll-view>
      <view class="sheet-actions"><button class="cancel-sheet" bindtap="closeReminderPanel">取消</button><button class="primary" bindtap="saveReminder" disabled="{{savingReminder}}">{{savingReminder ? '正在保存…' : '保存提醒'}}</button></view>
    </view>
  </view>
</view>
<view wx:elif="{{loading}}" class="page state">正在加载赛事资料…</view>
<view wx:else class="page state">{{error}}</view>
