/* 详情页（2026-10 改版）。颜色变量见 app.wxss */
.detail-page { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.state { text-align: center; padding-top: 180rpx; color: var(--muted); }

/* 顶部 */
.hero { background: var(--surface); padding: 32rpx 32rpx 36rpx; display: flex; flex-direction: column; gap: 16rpx; }
.hero-row { display: flex; align-items: center; gap: 20rpx; font-size: 26rpx; }
.title { font-size: 42rpx; font-weight: 700; line-height: 1.4; letter-spacing: .4rpx; }
.hero-meta { display: flex; flex-wrap: wrap; gap: 4rpx 28rpx; font-size: 27rpx; color: var(--ink2); }
.hero-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.hero-tags text { font-size: 24rpx; padding: 4rpx 18rpx; border-radius: 12rpx; background: var(--chip); color: var(--ink2); }

.body { padding: 24rpx 24rpx 0; display: flex; flex-direction: column; gap: 24rpx; }
.sec { background: var(--surface); border-radius: 32rpx; padding: 28rpx 32rpx; }
.sec-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }

/* 关键时间：竖向时间线 */
.tl { display: flex; flex-direction: column; }
.tl-item { position: relative; display: flex; justify-content: space-between; gap: 20rpx; padding: 0 0 28rpx 44rpx; font-size: 28rpx; }
.tl-item:last-child { padding-bottom: 0; }
.tl-item::before { content: ""; position: absolute; left: 6rpx; top: 14rpx; width: 18rpx; height: 18rpx; box-sizing: border-box; border-radius: 50%; border: 4rpx solid var(--line); background: var(--surface); }
.tl-item::after { content: ""; position: absolute; left: 14rpx; top: 38rpx; bottom: 0; width: 4rpx; background: var(--line); }
.tl-item:last-child::after { display: none; }
.tl-item.key::before { border-color: var(--accent); background: var(--accent); }
.tl-k { color: var(--ink2); flex: none; }
.tl-v { font-weight: 600; text-align: right; display: flex; flex-direction: column; align-items: flex-end; min-width: 0; }
.tl-v.todo { color: var(--muted); font-weight: 400; }
.tl-note { font-size: 24rpx; font-weight: 400; color: var(--muted); }
.time-note { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); display: flex; flex-direction: column; gap: 4rpx; }
.time-note-k { font-size: 24rpx; color: var(--muted); }
.time-note-body { color: var(--ink2); font-size: 26rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
.next-edition { margin-top: 16rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }

/* 时间提醒（测试要求保留 .timing-school_controlled / .timing-unverified） */
.timing-warning { border-radius: 28rpx; padding: 22rpx 28rpx; }
.timing-head { font-size: 27rpx; font-weight: 700; margin-bottom: 6rpx; }
.timing-note { font-size: 25rpx; line-height: 1.6; }
.timing-school_controlled { background: #fff2ec; }
.timing-school_controlled .timing-head { color: #b4501f; }
.timing-school_controlled .timing-note { color: #7d4526; }
.timing-unverified { background: #fdf3e4; }
.timing-unverified .timing-head { color: #8a6a10; }
.timing-unverified .timing-note { color: #6d5718; }

/* 可折叠块：推荐理由、参赛与规则、官方信息 */
.fold { display: flex; align-items: center; gap: 8rpx; min-height: 48rpx; }
.fold .rec { font-size: 30rpx; }
.fold-title { flex: 1; font-size: 30rpx; font-weight: 700; }
.fold .rec + .fold-title { font-weight: 600; }
.fold-arrow { color: var(--muted); font-size: 30rpx; line-height: 1; transition: transform .2s; }
.fold-arrow.open { transform: rotate(180deg); }
.fold-body { margin-top: 12rpx; font-size: 28rpx; line-height: 1.7; }
.label { margin-top: 20rpx; font-size: 24rpx; color: var(--muted); }
.value { color: var(--ink); white-space: pre-wrap; word-break: break-all; }
.bullet { color: var(--ink); }
.confidence { margin-top: 20rpx; color: var(--muted); font-size: 24rpx; }
.insufficient { color: var(--muted); }
.tag-row { display: flex; gap: 12rpx; flex-wrap: wrap; margin: 8rpx 0 4rpx; }
.tag-row text { background: var(--accent-soft); color: var(--accent); padding: 4rpx 16rpx; border-radius: 12rpx; font-size: 24rpx; }
.rewards-text { white-space: pre-wrap; word-break: break-all; }
.edition-meta { display: flex; gap: 16rpx; margin-top: 12rpx; }
.edition-meta view { display: flex; flex-direction: column; gap: 4rpx; flex: 1; background: var(--chip); border-radius: 20rpx; padding: 14rpx 20rpx; font-size: 27rpx; }
.edition-meta text:first-child { font-size: 22rpx; color: var(--muted); }

/* 页脚 */
.foot { text-align: center; padding: 12rpx 16rpx 8rpx; display: flex; flex-direction: column; gap: 16rpx; }
.feedback-link { color: var(--accent); font-size: 26rpx; }
.disclaimer { color: var(--muted); font-size: 22rpx; line-height: 1.6; }

/* 底部操作栏 */
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--line); }
.icon-action { flex: none; width: 104rpx; display: flex; flex-direction: column; align-items: center; gap: 2rpx; font-size: 22rpx; color: var(--ink2); }
.icon-glyph { font-size: 42rpx; line-height: 44rpx; color: var(--ink2); }
.icon-img { width: 44rpx; height: 44rpx; }
.fav-on, .fav-on .icon-glyph { color: var(--star); }
.rem-on { color: var(--accent); }
.cta { flex: 1; margin: 0; height: 88rpx; line-height: 88rpx; border-radius: 24rpx; background: var(--accent); color: #fff; font-size: 30rpx; font-weight: 600; }
.cta::after { border: 0; }
.cta[disabled] { background: var(--chip) !important; color: var(--muted) !important; }

/* 设置提醒弹层 */
.reminder-mask { position: fixed; z-index: 1000; inset: 0; background: rgba(15, 23, 42, .45); display: flex; align-items: flex-end; }
.reminder-sheet { width: 100%; height: 78vh; max-height: 1080rpx; background: #fff; border-radius: 36rpx 36rpx 0 0; display: flex; flex-direction: column; overflow: hidden; }
.sheet-handle { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: var(--line); margin: 16rpx auto 4rpx; }
.sheet-head { display: flex; justify-content: space-between; align-items: flex-start; padding: 16rpx 32rpx 24rpx; border-bottom: 1rpx solid var(--line); }
.sheet-title { font-size: 34rpx; font-weight: 700; }
.sheet-subtitle { font-size: 24rpx; color: var(--muted); margin-top: 6rpx; }
.sheet-close { font-size: 44rpx; color: var(--muted); padding: 0 8rpx; line-height: 1; }
.sheet-scroll { flex: 1; min-height: 0; padding: 0 32rpx; box-sizing: border-box; }
.reminder-section { padding-top: 32rpx; }
.reminder-label { font-weight: 700; margin-bottom: 16rpx; }
.event-options { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.event-option { border: 1rpx solid transparent; border-radius: 24rpx; padding: 20rpx 24rpx; background: var(--chip); }
.event-option view { font-weight: 600; }
.event-option text { display: block; color: var(--muted); font-size: 23rpx; margin-top: 6rpx; }
.option-active { color: var(--accent) !important; background: var(--accent-soft) !important; border-color: var(--accent) !important; }
.option-disabled { opacity: .45; }
.custom-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.custom-row picker { background: var(--chip); border-radius: 20rpx; padding: 20rpx; text-align: center; }
.reminder-tip { margin: 32rpx 0; color: var(--muted); font-size: 23rpx; line-height: 1.6; }
.sheet-actions { display: grid; grid-template-columns: 200rpx 1fr; gap: 18rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); }
.sheet-actions button { margin: 0; border-radius: 24rpx; }
.cancel-sheet { background: #fff !important; color: var(--ink2) !important; border: 1rpx solid var(--line); }
