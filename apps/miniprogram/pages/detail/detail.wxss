.summary,.recommendation,.text-card,.info{padding:26rpx}.status{display:inline-block;background:#1765d9;color:#fff;border-radius:999rpx;padding:7rpx 16rpx;font-size:23rpx}.title{font-size:38rpx;font-weight:750;line-height:1.4;margin:18rpx 0 6rpx}.tag-row{display:flex;gap:10rpx;flex-wrap:wrap;margin:20rpx 0}.tag-row text{background:#eef4ff;color:#315b96;padding:6rpx 12rpx;border-radius:8rpx;font-size:22rpx}.ghost{background:#fff!important;color:#1765d9!important;border:1rpx solid #aac6ee;margin-top:18rpx}.favorited{background:#e5efff!important;border-color:#83ade8!important}.recommendation{margin-top:18rpx;line-height:1.65}.recommendation-head{display:flex;gap:14rpx;align-items:center;font-size:34rpx;color:#24528f;font-weight:750}.reference{font-size:22rpx;color:#8592a5;font-weight:400}.label{font-weight:700;color:#334155;margin-top:20rpx;margin-bottom:6rpx}.bullet{color:#4a586b}.confidence{margin-top:20rpx;color:#6d7888;font-size:24rpx}.info view{display:flex;justify-content:space-between;padding:17rpx 0;border-bottom:1rpx solid #edf0f3}.info view:last-child{border:none}.text-card{line-height:1.65}.source{font-size:23rpx;color:#446172;word-break:break-all;margin-bottom:10rpx}.notice{background:#f3f6f8;color:#6d7787;padding:16rpx;border-radius:12rpx;margin-top:18rpx;font-size:22rpx}.action{margin-top:18rpx}.secondary{background:#fff!important;color:#1765d9!important;border:1rpx solid #aac6ee}.disclaimer{color:#6f7b8c;font-size:22rpx;line-height:1.6;padding:28rpx 8rpx}.state{text-align:center;padding-top:180rpx;color:#6b778c}
.reminder-action{background:#eaf2ff!important;color:#155bbf!important;border:1rpx solid #aac6ee}.reminder-mask{position:fixed;z-index:1000;inset:0;background:rgba(15,23,42,.48);display:flex;align-items:flex-end}.reminder-sheet{width:100%;height:78vh;max-height:1080rpx;background:#fff;border-radius:30rpx 30rpx 0 0;display:flex;flex-direction:column;overflow:hidden}.sheet-handle{width:72rpx;height:8rpx;border-radius:999rpx;background:#d8dee6;margin:16rpx auto 4rpx}.sheet-head{display:flex;justify-content:space-between;align-items:flex-start;padding:16rpx 28rpx 20rpx;border-bottom:1rpx solid #edf0f4}.sheet-title{font-size:34rpx;font-weight:750}.sheet-subtitle{font-size:22rpx;color:#7b8798;margin-top:6rpx}.sheet-close{font-size:42rpx;color:#718096;padding:0 8rpx}.sheet-scroll{flex:1;min-height:0;padding:0 28rpx;box-sizing:border-box}.reminder-section{padding-top:28rpx}.reminder-label{font-weight:700;color:#27364a;margin-bottom:16rpx}.event-options{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.event-option{border:1rpx solid #d7e0e7;border-radius:14rpx;padding:18rpx;background:#f7f9fa}.event-option view{font-weight:650}.event-option text{display:block;color:#7a8798;font-size:22rpx;margin-top:6rpx}.advance-options{display:flex;flex-wrap:wrap;gap:14rpx}.advance-option{min-width:190rpx;text-align:center;box-sizing:border-box;background:#f3f6f8;border:1rpx solid transparent;border-radius:12rpx;padding:15rpx;font-size:24rpx}.option-active{color:#1765d9!important;background:#e9f2ff!important;border-color:#92b8ef!important}.option-disabled{opacity:.4}.custom-head{display:flex;justify-content:space-between;align-items:center}.custom-row{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.custom-row picker{background:#f3f6f8;border-radius:12rpx;padding:17rpx;text-align:center}.custom-disabled{opacity:.45;pointer-events:none}.reminder-tip{margin:30rpx 0;color:#7c899a;font-size:22rpx;line-height:1.6}.sheet-actions{display:grid;grid-template-columns:210rpx 1fr;gap:18rpx;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e8edf2}.sheet-actions button{margin:0}.cancel-sheet{background:#fff!important;color:#526174!important;border:1rpx solid #cfd8e2}
.timing-warning{padding:22rpx;margin-top:-6rpx}.timing-head{font-size:27rpx;font-weight:700;margin-bottom:10rpx}.timing-note{font-size:24rpx;line-height:1.6}.timing-school_controlled{background:#fff2ec;border-left:8rpx solid #d2622f}.timing-school_controlled .timing-head{color:#b4501f}.timing-school_controlled .timing-note{color:#7d4526}.timing-unverified{background:#fff8e6;border-left:8rpx solid #c99a1e}.timing-unverified .timing-head{color:#8a6a10}.timing-unverified .timing-note{color:#6d5718}
.edition-meta{display:flex;gap:12rpx;margin-top:16rpx}.edition-meta view{display:flex;flex-direction:column;gap:4rpx;flex:1;background:#f1f6ff;border-radius:12rpx;padding:12rpx 16rpx;font-size:25rpx;color:#20385c}.edition-meta text:first-child{font-size:21rpx;color:#738596}
.fold-heading{display:flex;align-items:center;justify-content:space-between;margin:22rpx 0 12rpx;padding:22rpx 26rpx;background:#fff;border-radius:16rpx;color:#263849;font-size:29rpx;font-weight:700}.fold-action{color:#1765d9;font-size:23rpx;font-weight:500}
.recommendation-toggle{margin-left:auto;color:#1765d9;font-size:23rpx;font-weight:500}

/* 某一项资料缺失：写“信息不足”，用浅色区分（2026-10-01） */
.insufficient { color: #94a3b8; }
