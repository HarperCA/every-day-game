.preview-banner{background:#fff7df;color:#805b18;padding:16rpx;border-radius:14rpx;margin-bottom:18rpx;font-size:23rpx}.summary,.recommendation,.text-card,.info{padding:26rpx}.status{display:inline-block;background:#087e8b;color:#fff;border-radius:999rpx;padding:7rpx 16rpx;font-size:23rpx}.title{font-size:38rpx;font-weight:750;line-height:1.4;margin:18rpx 0 6rpx}.tag-row{display:flex;gap:10rpx;flex-wrap:wrap;margin:20rpx 0}.tag-row text{background:#eef5f6;color:#33626a;padding:6rpx 12rpx;border-radius:8rpx;font-size:22rpx}.ghost{background:#fff!important;color:#087e8b!important;border:1rpx solid #9ec9ce;margin-top:18rpx}.favorited{background:#e4f3f4!important;border-color:#60aeb6!important}.recommendation{margin-top:18rpx;line-height:1.65}.recommendation-head{display:flex;gap:14rpx;align-items:center;font-size:34rpx;color:#155e75;font-weight:750}.reference{font-size:22rpx;color:#8592a5;font-weight:400}.label{font-weight:700;color:#334155;margin-top:20rpx;margin-bottom:6rpx}.bullet{color:#4a586b}.confidence{margin-top:20rpx;color:#6d7888;font-size:24rpx}.info view{display:flex;justify-content:space-between;padding:17rpx 0;border-bottom:1rpx solid #edf0f3}.info view:last-child{border:none}.text-card{line-height:1.65}.source{font-size:23rpx;color:#446172;word-break:break-all;margin-bottom:10rpx}.notice{background:#f3f6f8;color:#6d7787;padding:16rpx;border-radius:12rpx;margin-top:18rpx;font-size:22rpx}.action{margin-top:18rpx}.secondary{background:#fff!important;color:#087e8b!important;border:1rpx solid #8fc2c8}.disclaimer{color:#6f7b8c;font-size:22rpx;line-height:1.6;padding:28rpx 8rpx}.state{text-align:center;padding-top:180rpx;color:#6b778c}
.reminder-action{background:#e8f4f5!important;color:#08717d!important;border:1rpx solid #8fc7cc}.reminder-mask{position:fixed;z-index:1000;inset:0;background:rgba(15,23,42,.48);display:flex;align-items:flex-end}.reminder-sheet{width:100%;height:78vh;max-height:1080rpx;background:#fff;border-radius:30rpx 30rpx 0 0;display:flex;flex-direction:column;overflow:hidden}.sheet-handle{width:72rpx;height:8rpx;border-radius:999rpx;background:#d8dee6;margin:16rpx auto 4rpx}.sheet-head{display:flex;justify-content:space-between;align-items:flex-start;padding:16rpx 28rpx 20rpx;border-bottom:1rpx solid #edf0f4}.sheet-title{font-size:34rpx;font-weight:750}.sheet-subtitle{font-size:22rpx;color:#7b8798;margin-top:6rpx}.sheet-close{font-size:42rpx;color:#718096;padding:0 8rpx}.sheet-scroll{flex:1;min-height:0;padding:0 28rpx;box-sizing:border-box}.reminder-section{padding-top:28rpx}.reminder-label{font-weight:700;color:#27364a;margin-bottom:16rpx}.event-options{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.event-option{border:1rpx solid #d7e0e7;border-radius:14rpx;padding:18rpx;background:#f7f9fa}.event-option view{font-weight:650}.event-option text{display:block;color:#7a8798;font-size:22rpx;margin-top:6rpx}.advance-options{display:flex;flex-wrap:wrap;gap:14rpx}.advance-option{min-width:190rpx;text-align:center;box-sizing:border-box;background:#f3f6f8;border:1rpx solid transparent;border-radius:12rpx;padding:15rpx;font-size:24rpx}.option-active{color:#087e8b!important;background:#e5f3f4!important;border-color:#76bbc1!important}.option-disabled{opacity:.4}.custom-head{display:flex;justify-content:space-between;align-items:center}.custom-row{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.custom-row picker{background:#f3f6f8;border-radius:12rpx;padding:17rpx;text-align:center}.custom-disabled{opacity:.45;pointer-events:none}.reminder-tip{margin:30rpx 0;color:#7c899a;font-size:22rpx;line-height:1.6}.sheet-actions{display:grid;grid-template-columns:210rpx 1fr;gap:18rpx;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e8edf2}.sheet-actions button{margin:0}.cancel-sheet{background:#fff!important;color:#526174!important;border:1rpx solid #cfd8e2}
