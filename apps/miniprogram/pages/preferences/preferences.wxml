<!-- 比赛偏好（2026-10 改版）：一页填完，微信设置页风格。地区用系统选择器，专业大类一行一个、右边打勾 -->
<view class="pref-page">
  <view class="gh">地区</view>
  <view class="grp">
    <picker mode="multiSelector" range="{{[provinceOptions]}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
      <view class="cell"><text class="k">所在地区</text><text class="v">{{provinceOptions[provinceIndex[0]]}}</text><text class="chev">›</text></view>
    </picker>
  </view>

  <view class="gh">想参加的专业大类（可多选，已选 {{categories.length}} 个）</view>
  <view class="grp">
    <view class="cell {{item.selected ? 'on' : ''}}" wx:for="{{categoryOptions}}" wx:key="label" data-value="{{item.value}}" bindtap="selectCategory" role="checkbox" aria-checked="{{item.selected}}">
      <text class="k">{{item.label}}</text><text class="ck">✓</text>
    </view>
  </view>

  <view class="gh">其他</view>
  <view class="grp">
    <checkbox-group bindchange="onDontShowAgainChange">
      <label class="cell"><text class="k">不再弹出偏好调查</text><checkbox value="hide" checked="{{dontShowAgain}}" color="#1765d9" /></label>
    </checkbox-group>
  </view>
  <view class="foot">首页会按这里的地区和专业大类默认筛选，全国性比赛也会显示。</view>

  <button class="save" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button>
</view>
