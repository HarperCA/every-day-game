<view class="page preferences-page">
  <view class="card preferences-card">
    <view class="step-count">{{step + 1}} / 2</view>
    <block wx:if="{{step === 0}}">
      <view class="question">你所在的地区是哪里？</view>
      <picker-view class="wheel" value="{{provinceIndex}}" bindchange="onProvinceChange" indicator-style="height:72rpx;" aria-label="上下滑动选择地区">
        <picker-view-column><view class="wheel-option" wx:for="{{provinceOptions}}" wx:key="*this">{{item}}</view></picker-view-column>
      </picker-view>
    </block>
    <block wx:else>
      <view class="question">你想参加哪些专业大类的比赛？（可多选）</view>
      <picker-view class="wheel" value="{{categoryIndex}}" bindchange="onCategoryChange" indicator-style="height:72rpx;" aria-label="上下滑动选择专业大类">
        <picker-view-column><view class="wheel-option {{item.selected ? 'selected' : ''}}" wx:for="{{categoryOptions}}" wx:key="label" data-value="{{item.value}}" bindtap="selectCategory">{{item.label}}{{item.selected ? ' ✓' : ''}}</view></picker-view-column>
      </picker-view>
      <view class="tags"><view class="tag" wx:for="{{categories}}" wx:key="*this" data-value="{{item}}" bindtap="selectCategory">{{item}} ×</view></view>
    </block>
    <checkbox-group bindchange="onDontShowAgainChange"><label class="optout"><checkbox value="hide" checked="{{dontShowAgain}}" color="#1765d9"/><text>不再显示偏好调查弹窗</text></label></checkbox-group>
    <view class="actions">
      <button class="secondary" bindtap="cancel" disabled="{{saving}}">取消</button>
      <button wx:if="{{step > 0}}" class="secondary" bindtap="previousStep" disabled="{{saving}}">上一步</button>
      <button class="primary" bindtap="confirmStep" loading="{{saving}}" disabled="{{saving}}">{{step < 1 ? '确定，下一步' : '确定，完成'}}</button>
    </view>
  </view>
</view>
