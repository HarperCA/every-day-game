/* 比赛偏好（2026-10 改版）：铺满式。颜色变量见 app.wxss */
.pref-page { min-height: 100vh; padding-bottom: 64rpx; box-sizing: border-box; }
.gh { padding: 32rpx 32rpx 12rpx; font-size: 25rpx; color: var(--muted); }
.grp { background: var(--surface); border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); }
.cell { position: relative; display: flex; align-items: center; gap: 24rpx; min-height: 100rpx; padding: 0 32rpx; font-size: 32rpx; }
.cell + .cell::before { content: ""; position: absolute; top: 0; left: 32rpx; right: 0; height: 1rpx; background: var(--line); }
.k { flex: 1; }
.v { color: var(--ink2); font-size: 30rpx; }
.chev { color: var(--muted); font-size: 36rpx; line-height: 1; }
.ck { width: 44rpx; text-align: center; color: var(--accent); font-size: 32rpx; font-weight: 700; visibility: hidden; }
.cell.on .k { color: var(--accent); }
.cell.on .ck { visibility: visible; }
.foot { padding: 20rpx 32rpx 0; font-size: 25rpx; color: var(--muted); line-height: 1.7; }
.save { margin: 44rpx 32rpx 0; height: 92rpx; line-height: 92rpx; border-radius: 16rpx; background: var(--accent); color: #fff; font-size: 32rpx; font-weight: 600; }
.save::after { border: 0; }
.save[disabled] { opacity: .6; }
