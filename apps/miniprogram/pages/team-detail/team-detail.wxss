@import "/templates/profile-sheet.wxss";
/* 队伍页（2026-11-05）。颜色变量见 app.wxss；分块样式同详情页 .hero、.sec */
.td-page { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.td-state-page { padding-top: 180rpx; text-align: center; color: var(--muted); }
.td-hero { background: var(--surface); padding: 32rpx 32rpx 36rpx; }
.td-comp { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; line-height: 1.5; color: var(--ink2); }
.td-comp-name { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.td-chev { flex: none; color: var(--muted); font-size: 32rpx; line-height: 1; }
.td-name { margin-top: 12rpx; font-size: 42rpx; font-weight: 700; line-height: 1.4; word-break: break-all; }
.td-intro { margin-top: 8rpx; font-size: 28rpx; line-height: 1.6; color: var(--ink2); word-break: break-all; }
.td-body { padding: 24rpx 24rpx 0; display: flex; flex-direction: column; gap: 24rpx; }
.td-banner { border-radius: 28rpx; padding: 24rpx 28rpx; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.banner-done { background: #e6f4ec; color: #1f8a55; }
.banner-wait { background: #fdf3e4; color: var(--amber); }
.banner-plain { background: var(--chip); color: var(--ink2); }
.td-sec { background: var(--surface); border-radius: 32rpx; padding: 28rpx 32rpx; }
.td-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }
.td-title-tight { margin-bottom: 4rpx; }
.td-num { color: var(--accent); }
.td-contact { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.td-contact-text { min-width: 0; }
.td-wechat { font-size: 28rpx; color: var(--ink2); word-break: break-all; }
.td-ava { flex: none; width: 72rpx; height: 72rpx; line-height: 72rpx; border-radius: 50%; background: var(--accent-soft); color: var(--accent); text-align: center; font-size: 30rpx; font-weight: 600; }
.td-person-name { font-size: 30rpx; font-weight: 500; }
.td-small { flex: none; margin: 0; width: 132rpx; height: 64rpx; line-height: 62rpx; padding: 0; border-radius: 32rpx; font-size: 26rpx; font-weight: 600; }
.td-small::after { border: 0; }
.td-small-plain { background: var(--surface); color: var(--ink2); border: 1rpx solid var(--line); }
.td-small-main { background: var(--accent); color: #fff; border: 1rpx solid var(--accent); }
.td-card { width: 440rpx; padding: 20rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: 16rpx; }
.td-card-title { font-size: 28rpx; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.td-card-img { display: block; width: 100%; height: 320rpx; margin-top: 14rpx; border-radius: 8rpx; }
.td-share { margin: 24rpx 0 0; width: 100%; height: 88rpx; line-height: 88rpx; padding: 0; border-radius: 24rpx; background: var(--accent); color: #fff; font-size: 30rpx; font-weight: 600; }
.td-share::after { border: 0; }
.td-member { display: flex; align-items: center; gap: 20rpx; }
.td-member + .td-member { margin-top: 16rpx; }
.td-member-text { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 4rpx 12rpx; }
.td-captain { padding: 2rpx 14rpx; border-radius: 10rpx; background: var(--accent-soft); color: var(--accent); font-size: 22rpx; line-height: 1.6; }
.td-toggle { margin: 24rpx 0 0; width: 100%; height: 76rpx; line-height: 76rpx; padding: 0; border-radius: 20rpx; background: var(--chip); color: var(--ink2); font-size: 26rpx; font-weight: 600; }
.td-toggle::after { border: 0; }
.td-withdraw { margin: 0; width: 100%; height: 84rpx; line-height: 82rpx; padding: 0; border-radius: 24rpx; background: var(--surface); color: var(--ink2); border: 1rpx solid var(--line); font-size: 28rpx; font-weight: 600; }
.td-withdraw::after { border: 0; }
.td-dissolve { margin: 16rpx 0 0; width: 100%; height: 84rpx; line-height: 82rpx; padding: 0; border-radius: 24rpx; background: var(--surface); color: #c24141; border: 1rpx solid #f0c9c9; font-size: 28rpx; font-weight: 500; }
.td-dissolve::after { border: 0; }
.td-label { margin: 22rpx 0 10rpx; font-size: 26rpx; font-weight: 600; color: var(--ink2); }
.td-input { box-sizing: border-box; height: 80rpx; padding: 0 20rpx; border-radius: 20rpx; background: var(--chip); font-size: 28rpx; }
.td-area { box-sizing: border-box; width: 100%; height: 150rpx; padding: 18rpx 20rpx; border-radius: 20rpx; background: var(--chip); font-size: 28rpx; line-height: 1.6; }
.td-holder { color: var(--muted); }
.td-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--line); }
.td-submit { margin: 0; width: 100%; height: 88rpx; line-height: 88rpx; padding: 0; border-radius: 24rpx; background: var(--accent); color: #fff; font-size: 30rpx; font-weight: 600; }
.td-submit::after { border: 0; }
.td-ava-img { display: block; }
.td-me { font-size: 24rpx; color: var(--accent); }
.td-tip { margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; color: var(--muted); }
.td-need-wechat { border: 2rpx solid var(--accent); }
.td-edit-row { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; }
.td-edit-input { flex: 1; min-width: 0; }
.td-picker { display: flex; align-items: center; justify-content: space-between; line-height: 80rpx; }
.td-pending { display: flex; align-items: center; justify-content: space-between; }
.td-retry { margin-top: 24rpx; display: inline-block; }
