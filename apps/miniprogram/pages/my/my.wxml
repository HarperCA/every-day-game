<brand-nav />
<view class="page">
  <view class="profile card" bindtap="openProfile">
    <view class="avatar"><image wx:if="{{avatarPath}}" src="{{avatarPath}}" mode="aspectFill" /><text wx:else>微</text></view>
    <view class="profile-info">
      <view class="name">{{loginState === 'success' ? profileName : '未登录'}}</view>
      <view class="muted" wx:if="{{loginState === 'loading'}}">正在连接微信身份…</view>
      <view class="muted" wx:elif="{{loginState === 'failed'}}">微信登录失败：{{loginError}}</view>
      <view class="muted" wx:if="{{loginState === 'success' && dataSyncState === 'loading'}}">正在同步收藏与提醒…</view>
      <view class="muted sync-warning" wx:if="{{loginState === 'success' && dataSyncState === 'partial'}}">微信登录成功，但部分数据暂未同步：{{dataSyncError}}</view>
    </view>
    <button wx:if="{{loginState === 'idle'}}" class="wechat-login" catchtap="requestWechatLogin">微信登录</button>
    <button wx:if="{{loginState === 'failed'}}" class="wechat-login" catchtap="requestWechatLogin">重新登录</button>
    <text wx:if="{{loginState === 'success'}}" class="profile-arrow">›</text>
  </view>
  <view class="menu card"><view bindtap="openFavorites">我的收藏<text>{{favoriteCount}} 场 ›</text></view><view bindtap="openReminders">我的提醒<text>{{reminderCount}} 项 ›</text></view><view bindtap="openFeedback">信息纠错<text>提交与进度 ›</text></view></view>
  <view class="menu card"><view bindtap="openGeneralFeedback">意见反馈<text>建议与处理进度 ›</text></view><view bindtap="openCompetitionPreferences">比赛偏好<text>修改专业大类、比赛大类与地区 ›</text></view><view bindtap="openRecommendationGuide">推荐等级说明<text>›</text></view><view bindtap="openPrivacyGuide">隐私说明<text>›</text></view><view bindtap="openAbout">关于<text>›</text></view></view>
</view>
