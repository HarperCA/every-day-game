.profile{display:flex;align-items:center;gap:20rpx;padding:28rpx}.avatar{width:84rpx;height:84rpx;background:#dceff1;color:#087e8b;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:700}.name{font-size:32rpx;font-weight:700}.profile button{margin-left:auto}.sync-warning{color:#b45309}.menu{margin-top:20rpx;padding:0 24rpx}.menu view{display:flex;justify-content:space-between;padding:28rpx 4rpx;border-bottom:1rpx solid #edf0f3}.menu view:last-child{border:none}.menu text{color:#8b96a6}.privacy{color:#738095;font-size:23rpx;line-height:1.65;padding:28rpx 10rpx}
.wechat-login{background:#07c160!important;color:#fff!important;border:0!important}
