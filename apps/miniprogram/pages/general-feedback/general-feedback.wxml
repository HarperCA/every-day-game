<!-- 意见反馈（2026-10 改版）：铺满式表单，和信息纠错同一种写法 -->
<view class="gf-page">
  <view class="gh">反馈</view>
  <view class="grp">
    <picker range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="cell"><text class="k">反馈类型</text><text class="v">{{types[typeIndex].label}}</text><text class="chev">›</text></view>
    </picker>
  </view>

  <view class="gh">反馈内容 <text class="req">必填</text></view>
  <view class="grp ta">
    <textarea value="{{content}}" bindinput="onContentInput" maxlength="2000" placeholder="遇到了什么问题，或者希望怎么改进？" placeholder-class="ph-text" />
    <view class="count">{{content.length}} / 2000</view>
  </view>

  <view class="gh">联系方式 <text class="opt">选填</text></view>
  <view class="grp">
    <view class="cell"><text class="k">联系方式</text><input class="inp" value="{{contact}}" bindinput="onContactInput" maxlength="100" placeholder="微信或邮箱，方便回复你" placeholder-class="ph-text" /></view>
  </view>

  <button class="submit" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提交反馈</button>

  <view class="gh"></view>
  <view class="grp">
    <view class="cell" bindtap="openRecords"><text class="k">我的反馈</text><text class="v">处理进度和回复</text><text class="chev">›</text></view>
  </view>
</view>
