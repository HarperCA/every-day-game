page{background:#f4f7fc;color:#172235;font-size:28rpx}.feedback-page{padding:28rpx 28rpx 200rpx}.records-link{text-align:right;color:#1765d9;padding:8rpx 4rpx 28rpx}.records-link text{margin-left:10rpx}.form{background:#fff;border-radius:18rpx;overflow:hidden}.type-row{display:flex;justify-content:space-between;align-items:center;padding:32rpx;border-bottom:1rpx solid #eef1f5}.arrow{color:#a2aaba;margin-left:18rpx}.content-area{padding:32rpx}.label{font-weight:600;margin-bottom:24rpx}textarea{width:100%;height:340rpx;line-height:1.7;font-size:28rpx}.count{text-align:right;color:#929baa;font-size:24rpx;padding-top:14rpx}.contact-row{display:flex;align-items:center;gap:32rpx;background:#fff;border-radius:18rpx;padding:32rpx;margin-top:24rpx}.contact-row input{flex:1;min-width:0;font-size:28rpx}.submit-area{position:fixed;bottom:0;left:0;right:0;background:#f4f7fc;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom))}.submit{background:#1765d9;color:#fff;border-radius:14rpx;font-size:30rpx;font-weight:500}.submit::after{border:0}.submit[disabled]{opacity:.6}
