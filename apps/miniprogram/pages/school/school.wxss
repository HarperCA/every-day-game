.sc-live { padding: 24rpx; }
.sc-panel { margin-bottom: 20rpx; padding: 24rpx; border-radius: 20rpx; background: var(--surface, #fff); overflow-wrap: anywhere; }
.sc-title { font-weight: 700; margin: 16rpx 0; }
.sc-row { padding: 16rpx 0; border-bottom: 1rpx solid var(--line, #ddd); }
.sc-actions { display: flex; flex-wrap: wrap; gap: 12rpx; }
.sc-row button, .sc-panel button { margin: 10rpx 10rpx 0 0; }
.sc-hero {
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(130deg, #14295c, #175bd6);
  color: #fff;
}
.sc-hero-count {
  display: inline-block;
  padding: 7rpx 15rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 24rpx;
}
.sc-hero-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.sc-hero-title { font-size: 44rpx; font-weight: 700; }
.sc-picker-trigger {
  display: flex; align-items: center; gap: 14rpx; min-width: 0; margin: 0;
  padding: 4rpx 16rpx; border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 14rpx; line-height: 1.4; color: #fff; background: rgba(255, 255, 255, 0.12);
}
.sc-picker-trigger .sc-hero-title { font-size: 36rpx; }
.sc-picker-chevron { flex-shrink: 0; font-size: 30rpx; color: #e5efff; }
.sc-picker-menu { margin-top: 14rpx; border-radius: 14rpx; background: var(--surface, #fff); color: var(--text, #1b2842); overflow: hidden; }
.sc-picker-list { max-height: 360rpx; }
.sc-picker-option { padding: 16rpx 20rpx; line-height: 1.45; font-size: 28rpx; overflow-wrap: anywhere; }
.sc-picker-option + .sc-picker-option { border-top: 1rpx solid var(--line, #ddd); }
.sc-picker-empty { padding: 18rpx 20rpx; font-size: 26rpx; }
.sc-school-filter { margin-top: 16rpx; }
.sc-school-filter-trigger { display: inline-flex; font-size: 26rpx; }
.sc-school-search { margin: 16rpx; padding: 12rpx 16rpx; border: 1rpx solid var(--line, #ddd); border-radius: 10rpx; font-size: 26rpx; }
.sc-hero-count { flex-shrink: 0; }
.sc-mode-row { display: flex; justify-content: flex-end; margin-bottom: 16rpx; }
.sc-mode { margin: 0; color: #fff; background: rgba(255, 255, 255, 0.18); }
.sc-mode::after { border: 0; }
.sc-section-title { margin: 24rpx 4rpx 16rpx; font-size: 30rpx; font-weight: 700; }
.sc-empty { padding: 52rpx 20rpx; text-align: center; color: var(--muted, #59677e); font-size: 27rpx; }
.sc-empty-title { color: var(--text, #1b2842); font-size: 29rpx; font-weight: 700; }
.sc-empty-note { margin-top: 12rpx; }
.sc-school-tag { display: inline-block; padding: 5rpx 14rpx; border-radius: 24rpx; background: #e7efff; color: #174da6; font-size: 23rpx; }
.sc-contest-title { margin-top: 12rpx; font-size: 32rpx; font-weight: 700; }
.sc-contest-date { margin-top: 10rpx; color: var(--muted, #59677e); font-size: 25rpx; }
.sc-contest-pressed { opacity: 0.85; }
.sc-contest-actions { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.sc-detail-label { color: #174da6; font-size: 26rpx; }
.sc-panel .sc-signup { margin: 0; padding: 0 20rpx; background: #e7efff; color: #174da6; }
.sc-account { margin-top: 24rpx; }
