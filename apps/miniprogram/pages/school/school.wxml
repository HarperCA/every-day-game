<brand-nav title="校赛" />
<view class="sc-live">
  <view wx:if="{{loading}}" class="sc-panel">正在加载校赛…</view>
  <view wx:if="{{error}}" class="sc-panel">
    <view>{{error}}</view>
    <button size="mini" bindtap="retry">重试</button>
  </view>
  <block wx:if="{{status}}">
    <view class="sc-university-picker">
      <view class="sc-hero">
        <view class="sc-mode-row" wx:if="{{adminSchool}}">
          <button size="mini" class="sc-mode" bindtap="toggleStudentView" disabled="{{loading || working}}">{{studentView ? '管理员工作台' : '返回校赛列表'}}</button>
        </view>
        <view class="sc-hero-row">
          <view class="sc-picker-trigger" role="button" aria-expanded="{{!!pickerStep}}" bindtap="toggleContestPicker">
            <text class="sc-hero-title">{{studentView ? (universitySelected ? schoolLabel : '选择你的大学') : (selectedAdminUniversity || '选择你的大学')}}</text>
            <text class="sc-picker-chevron">{{pickerStep ? '▴' : '▾'}}</text>
          </view>
          <view class="sc-hero-count">{{studentView ? visibleContests.length : selectedAdminUniversity && selectedAdminUniversity !== adminSchool ? adminBrowseContests.length : managed.length}} 场校赛</view>
        </view>
      </view>
      <block>
        <view wx:if="{{pickerStep === 'school'}}" class="sc-picker-menu">
          <input class="sc-school-search" placeholder="搜索学校名称" value="{{schoolQuery}}" bindinput="searchSchools" />
          <scroll-view scroll-y class="sc-picker-list" bindscrolltolower="showMoreSchools">
            <view wx:if="{{studentView}}" class="sc-picker-option" role="button" bindtap="selectSchoolFilter">全部学校</view>
            <view wx:for="{{schoolOptions}}" wx:key="*this" class="sc-picker-option" role="button" data-school="{{item}}" bindtap="selectSchoolFilter">{{item}}</view>
            <view wx:if="{{!schoolOptions.length}}" class="sc-picker-empty">未找到匹配的学校</view>
          </scroll-view>
        </view>
        <view wx:elif="{{pickerStep === 'contest'}}" class="sc-picker-menu">
          <view class="sc-picker-option sc-picker-back" role="button" bindtap="openSchoolChoices">‹ {{studentView ? schoolLabel : selectedAdminUniversity}} · 更换学校</view>
          <scroll-view wx:if="{{studentView ? visibleContests.length : selectedAdminUniversity !== adminSchool ? adminBrowseContests.length : managed.length}}" scroll-y class="sc-picker-list">
            <view wx:for="{{studentView ? visibleContests : selectedAdminUniversity !== adminSchool ? adminBrowseContests : managed}}" wx:key="id" class="sc-picker-option" role="button" data-id="{{item.id}}" bindtap="selectPickerContest">{{item.title}}{{!studentView && item.status ? ' · ' + item.status : ''}}</view>
          </scroll-view>
          <view wx:else class="sc-picker-empty">暂无可选比赛</view>
        </view>
      </block>
    </view>
    <view class="sc-panel" wx:if="{{adminSchool && !studentView && (!selectedAdminUniversity || selectedAdminUniversity === adminSchool)}}">
      <view class="sc-title">{{adminSchool}} · 管理员工作台</view>
      <view class="sc-actions">
        <button size="mini" bindtap="openCreate">提交校赛</button>
        <button size="mini" bindtap="changeInvite" disabled="{{working}}">生成邀请</button>
        <button size="mini" data-renew="yes" bindtap="changeInvite" disabled="{{working}}">更换邀请</button>
        <button wx:if="{{inviteCode}}" size="mini" open-type="share" disabled="{{working}}">转发邀请</button>
      </view>
      <view class="sc-title">学生名单</view>
      <view wx:if="{{!members.length && !loading}}">暂无学生</view>
      <view class="sc-row" wx:for="{{members}}" wx:key="id">
        <view>{{item.realName}} · {{item.college}} · {{item.major}} · {{item.studentNo}}</view>
        <button size="mini" data-action="remove" data-id="{{item.id}}" bindtap="confirmChange" disabled="{{working}}">移出</button>
      </view>
      <view class="sc-title">校赛及审核状态</view>
      <view wx:if="{{!managed.length && !loading}}">暂无提交记录</view>
      <view class="sc-row {{selectedManagedId === item.id ? 'sc-selected-managed' : ''}}" id="{{selectedManagedId === item.id ? 'sc-selected-managed' : ''}}" wx:for="{{managed}}" wx:key="id">
        <view>{{item.title}} · {{item.status}}</view>
        <view wx:if="{{item.reviewNote}}">{{item.reviewNote}}</view>
        <button wx:if="{{item.status === '已发布'}}" size="mini" data-action="withdraw" data-id="{{item.id}}" bindtap="confirmChange" disabled="{{working}}">下架</button>
      </view>
    </view>
    <view wx:elif="{{!studentView && selectedAdminUniversity}}" class="sc-panel">
      <view class="sc-title">{{selectedAdminUniversity}} · 已发布的校赛</view>
      <view wx:if="{{!adminBrowseContests.length && !loading}}">该校暂无当前账号可查看的已发布校赛。</view>
      <view class="sc-row" wx:for="{{adminBrowseContests}}" wx:key="id" data-id="{{item.id}}" bindtap="openContest">{{item.title}} ›</view>
      <button size="mini" bindtap="returnToManagedSchool">返回管理员工作台</button>
    </view>
    <view wx:if="{{(studentView || !adminSchool) && (status.memberships.length || status.adminSchools.length)}}">
      <view class="sc-section-title">已发布的校赛</view>
      <view wx:if="{{!visibleContests.length && !loading}}" class="sc-panel sc-empty">
        <view class="sc-empty-title">暂无可选比赛</view>
        <view class="sc-empty-note">{{selectedSchool ? '该校暂无当前账号可查看的已发布校赛。' : '学校发布新比赛后，会在这里显示。'}}</view>
      </view>
      <block wx:for="{{visibleContests}}" wx:key="id">
        <view class="sc-panel sc-contest" data-id="{{item.id}}" bindtap="openContest" hover-class="sc-contest-pressed">
          <view wx:if="{{item.school !== '官方的'}}" class="sc-school-tag">{{item.school}}</view>
          <view class="sc-contest-title">{{item.title}}</view>
          <view wx:if="{{item.startDate || item.endDate}}" class="sc-contest-date">赛程 {{item.startDate}}{{item.startDate && item.endDate ? ' 至 ' : ''}}{{item.endDate}}</view>
          <view class="sc-contest-actions">
            <text class="sc-detail-label">查看详情 ›</text>
            <button wx:if="{{item.signup}}" size="mini" class="sc-signup" data-id="{{item.id}}" data-signup="true" catchtap="openContest">查看报名方式</button>
          </view>
        </view>
      </block>
    </view>
    <view wx:elif="{{!status.memberships.length && !status.adminSchools.length}}" class="sc-panel sc-empty">
      <view class="sc-empty-title">还未加入学校</view>
      <view class="sc-empty-note">请向本校校赛管理员索取邀请卡片。</view>
    </view>
    <view class="sc-panel sc-account" wx:if="{{!studentView || !adminSchool}}">
      <button size="mini" bindtap="openApply">申请成为校赛管理员</button>
      <view class="sc-row" wx:for="{{status.applications}}" wx:key="id">
        <view>{{item.school}} · {{item.status}}</view>
        <view wx:if="{{item.reviewNote}}">{{item.reviewNote}}</view>
      </view>
      <view class="sc-row" wx:for="{{status.memberships}}" wx:key="id">
        <view>{{item.school}}</view>
        <button size="mini" data-action="leave" data-school="{{item.school}}" bindtap="confirmChange" disabled="{{working}}">退出学校</button>
      </view>
    </view>
  </block>
</view>
