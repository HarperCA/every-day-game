<!-- 我的提醒（2026-10 改版）：左边小日历是提醒时间；中间名称和事件；右边编辑、删除图标 -->
<view class="rem-page">
  <view class="count" wx:if="{{!loginRequired && !error && items.length}}">共 {{items.length}} 项，按提醒时间排列</view>

  <view wx:if="{{loginRequired}}" class="state"><view class="state-title">登录后查看提醒</view><view class="state-sub">提醒与当前微信账号关联。</view><button class="state-btn" bindtap="requestWechatLogin">微信登录</button></view>
  <view wx:elif="{{loading && items.length === 0}}"><view class="skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"><view></view><view></view></view></view>
  <view wx:elif="{{error}}" class="state"><view class="state-title">提醒加载失败</view><view class="state-sub">{{error}}</view><button class="state-btn" bindtap="retry">重新加载</button></view>
  <view wx:elif="{{items.length === 0}}" class="state">
    <view class="empty-icon">🔔</view>
    <view class="title-row"><text class="state-title">还没有设置提醒</text><text class="qmark {{emptyHelp ? 'on' : ''}}" bindtap="toggleEmptyHelp" role="button" aria-label="说明">?</text></view>
    <view wx:if="{{emptyHelp}}" class="tip">进入赛事详情，点底部铃铛设置报名开始或截止提醒。</view>
    <button class="state-btn" bindtap="goFindCompetition">去发现赛事</button>
  </view>
  <view wx:else>
    <view class="rcard {{item.isExpired ? 'past' : ''}}" wx:for="{{items}}" wx:key="id">
      <view class="cal">
        <text class="cal-m">{{item.remindMonth}}月</text>
        <text class="cal-d">{{item.remindDay}}</text>
        <text class="cal-t">{{item.remindTime}}</text>
      </view>
      <view class="rmid">
        <text class="rname {{item.unavailable ? 'na' : ''}}" data-edition-id="{{item.editionId}}" data-unavailable="{{item.unavailable}}" bindtap="openDetail">{{item.competitionName}}</text>
        <text class="rsub">{{item.eventLabel}} · {{item.advanceLabel}}</text>
        <text wx:if="{{item.unavailable}}" class="rflag">赛事资料暂不可读取或已下架，提醒仍保留</text>
        <text wx:elif="{{item.changeLabel}}" class="rflag warn">{{item.changeLabel}}</text>
        <text wx:elif="{{item.isManualRequired}}" class="rflag err">发送失败，请重新授权</text>
        <text wx:elif="{{item.isExpired}}" class="rflag">提醒时间已到</text>
        <view wx:if="{{!item.unavailable && (item.authorizationStatus !== 'accepted' || item.isManualRequired)}}" class="rauth">
          <text>{{item.isManualRequired ? '微信通知发送失败' : '还没开通微信通知'}}</text>
          <text class="rauth-btn" data-id="{{item.id}}" bindtap="authorize">{{item.isManualRequired ? '重新授权' : '去授权'}}</text>
        </view>
      </view>
      <view class="racts">
        <image wx:if="{{!item.unavailable}}" class="ract" src="/assets/rem-edit.svg" mode="aspectFit" data-edition-id="{{item.editionId}}" data-event-type="{{item.eventType}}" bindtap="editReminder" role="button" aria-label="编辑提醒" />
        <image class="ract" src="/assets/rem-trash.svg" mode="aspectFit" data-id="{{item.id}}" bindtap="deleteReminder" role="button" aria-label="删除提醒" />
      </view>
    </view>
  </view>
</view>
