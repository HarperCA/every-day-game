/* 我的提醒（2026-10 改版）。颜色变量见 app.wxss */
.rem-page { min-height: 100vh; padding: 24rpx 24rpx 48rpx; box-sizing: border-box; }
.count { margin: 0 8rpx 20rpx; font-size: 25rpx; color: var(--muted); }
.rcard { display: flex; align-items: flex-start; gap: 24rpx; background: var(--surface); border-radius: 32rpx; padding: 24rpx 16rpx 24rpx 24rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 4rpx rgba(23, 32, 51, .05), 0 12rpx 32rpx -20rpx rgba(23, 32, 51, .18); }
.cal { flex: none; width: 104rpx; border-radius: 20rpx; overflow: hidden; text-align: center; background: var(--accent-soft); color: var(--accent); display: flex; flex-direction: column; }
.cal-m { background: var(--accent); color: #fff; font-size: 22rpx; line-height: 36rpx; }
.cal-d { font-size: 40rpx; font-weight: 700; line-height: 52rpx; font-variant-numeric: tabular-nums; }
.cal-t { font-size: 22rpx; line-height: 32rpx; padding-bottom: 6rpx; font-variant-numeric: tabular-nums; }
.rcard.past .cal { background: var(--chip); color: var(--muted); }
.rcard.past .cal-m { background: var(--muted); }
.rmid { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.rname { font-size: 31rpx; font-weight: 600; line-height: 1.45; word-break: break-all; }
.rname.na { color: var(--muted); }
.rsub { font-size: 25rpx; color: var(--muted); }
.rflag { font-size: 24rpx; font-weight: 600; color: var(--muted); }
.rflag.warn { color: var(--amber); }
.rflag.err { color: #c4382a; }
.rauth { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; color: var(--amber); }
.rauth-btn { color: var(--accent); font-weight: 600; }
.racts { flex: none; display: flex; flex-direction: column; }
.ract { width: 72rpx; height: 72rpx; padding: 18rpx; box-sizing: border-box; }
.state { background: var(--surface); border-radius: 32rpx; padding: 72rpx 40rpx; text-align: center; display: flex; flex-direction: column; align-items: center; }
.state-title { font-size: 31rpx; font-weight: 700; }
.state-sub { margin-top: 12rpx; font-size: 26rpx; color: var(--muted); line-height: 1.65; }
.empty-icon { font-size: 72rpx; line-height: 1; margin-bottom: 20rpx; }
.title-row { display: flex; align-items: center; gap: 12rpx; }
.qmark { width: 36rpx; height: 36rpx; box-sizing: border-box; border-radius: 50%; border: 2rpx solid var(--muted); color: var(--muted); font-size: 23rpx; font-weight: 700; line-height: 32rpx; text-align: center; }
.qmark.on { border-color: var(--accent); color: var(--accent); }
.tip { margin-top: 14rpx; padding: 16rpx 24rpx; border-radius: 20rpx; background: var(--chip); color: var(--ink2); font-size: 25rpx; line-height: 1.6; }
.state-btn { margin-top: 32rpx; width: 330rpx; height: 76rpx; line-height: 76rpx; border-radius: 24rpx; background: var(--accent); color: #fff; font-size: 28rpx; font-weight: 600; }
.state-btn::after { border: 0; }
.skeleton { background: var(--surface); border-radius: 32rpx; padding: 32rpx; margin-bottom: 24rpx; }
.skeleton view { height: 24rpx; background: var(--chip); border-radius: 12rpx; margin: 16rpx 0; }
.skeleton view:first-child { width: 78%; height: 30rpx; }
.skeleton view:last-child { width: 52%; }
