<!-- 个人资料（2026-10 改版）：像微信自己的“个人信息”页，头像一行、名称一行 -->
<view class="pf-page">
  <view class="grp">
    <button class="row avatar-row" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="选择头像">
      <text class="k">头像</text>
      <view class="av"><image wx:if="{{avatarPath}}" src="{{avatarPath}}" mode="aspectFill" /><text wx:else>微</text></view>
      <text class="chev">›</text>
    </button>
    <form bindsubmit="save">
      <view class="row name-row"><text class="k">名称</text><input name="displayName" type="nickname" maxlength="20" value="{{displayName}}" bindinput="onNameInput" placeholder="请输入你的名称" placeholder-class="ph-text" /></view>
      <view class="foot">头像和名称只保存在这台手机上，不上传。</view>
      <button class="save-button" form-type="submit" loading="{{saving}}" disabled="{{saving}}">保存</button>
    </form>
  </view>
</view>
