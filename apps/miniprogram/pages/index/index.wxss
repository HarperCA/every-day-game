/* 吸顶区：品牌栏 + 搜索 + 筛选，往下滑时一起固定在顶部（2026-10 改版） */
.sticky-head { position:sticky; top:0; z-index:50; background:var(--bg); box-shadow:0 12rpx 20rpx -20rpx rgba(23,32,51,.25); }
.head-inner { padding:20rpx 24rpx 16rpx; display:flex; flex-direction:column; gap:16rpx; }
.search-line { display:flex; gap:16rpx; }
.search-row { flex:1; min-width:0; display:flex; align-items:center; gap:12rpx; height:80rpx; padding:0 10rpx 0 24rpx; background:var(--surface); border:1rpx solid var(--line); border-radius:24rpx; box-sizing:border-box; }
.search-icon { flex:none; width:34rpx; height:34rpx; }
.search-row input { flex:1; min-width:0; color:var(--ink); font-size:27rpx; }
.search-row button { flex:none; margin:0; height:60rpx; line-height:60rpx; padding:0 26rpx; background:var(--accent); color:#fff; font-size:26rpx; border-radius:18rpx; }
.search-row button::after { border:0; }
.assistant-button { flex:none; display:flex; align-items:center; gap:8rpx; height:80rpx; padding:0 22rpx 0 18rpx; border-radius:24rpx; border:1rpx solid var(--line); background:var(--surface); color:var(--accent); font-size:26rpx; font-weight:600; box-sizing:border-box; }
.assistant-button image { width:34rpx; height:34rpx; }
/* 筛选栏：左边状态标签（选中的黑色加粗，下面一条蓝色短横线），右边“筛选”（2026-10-24 改版） */
.filter-panel { display:flex; align-items:center; justify-content:space-between; gap:16rpx; height:72rpx; }
.status-tabs { display:flex; align-items:stretch; gap:44rpx; height:100%; }
.status-tab { position:relative; display:flex; align-items:center; color:var(--muted); font-size:29rpx; }
.status-tab-active { color:var(--ink); font-weight:700; font-size:31rpx; }
.status-tab-active::after { content:""; position:absolute; left:50%; bottom:2rpx; width:40rpx; height:6rpx; margin-left:-20rpx; border-radius:3rpx; background:var(--accent); }
.filter-trigger { position:relative; display:flex; flex:none; align-items:center; gap:8rpx; height:100%; padding:0 4rpx; color:var(--ink2); font-size:27rpx; }
.filter-trigger image { width:30rpx; height:30rpx; }
.filter-trigger-active { color:var(--accent); font-weight:600; }
.filter-count { min-width:30rpx; height:30rpx; padding:0 6rpx; border-radius:16rpx; background:var(--accent); color:#fff; font-size:19rpx; line-height:30rpx; text-align:center; box-sizing:border-box; font-weight:600; }
.result-meta { display:flex; justify-content:space-between; margin:4rpx 4rpx 20rpx; color:var(--muted); font-size:25rpx; }
.clear { color:var(--accent); }
/* 加载、没结果、出错 */
.state { text-align:center; padding:70rpx 30rpx; border:0; border-radius:32rpx; }.state-title{font-size:30rpx;font-weight:700;margin-bottom:12rpx}.state button{margin-top:24rpx}.load-more{text-align:center;padding:20rpx;color:var(--muted);font-size:24rpx}.skeleton{padding:30rpx 32rpx;margin-bottom:24rpx;border:0;border-radius:32rpx}.skeleton view{height:24rpx;background:var(--chip);border-radius:12rpx;margin:16rpx 0}.skeleton view:first-child{width:78%;height:30rpx}.skeleton view:last-child{width:52%}
/* 双列卡片的样式在 app.wxss（首页、收藏页共用） */
/* 没结果时的推荐搜索词 */
.suggest { display:flex; flex-wrap:wrap; justify-content:center; gap:14rpx; margin-top:24rpx; }
.suggest-chip { padding:10rpx 24rpx; border-radius:28rpx; background:var(--accent-soft); color:var(--accent); font-size:25rpx; }
.skeleton-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }
.skeleton-grid .skeleton { margin:0; padding:0 0 20rpx; border-radius:16rpx; overflow:hidden; }
.skeleton-grid .skeleton view { margin:16rpx 18rpx; }
.skeleton-grid .skeleton .skeleton-poster { width:auto; height:193rpx; margin:0; border-radius:0; }
.filter-mask { position:fixed; z-index:1000; inset:0; background:rgba(15,23,42,.48); display:flex; align-items:flex-end; }
.filter-sheet { width:100%; height:88vh; background:#fff; border-radius:30rpx 30rpx 0 0; display:flex; flex-direction:column; overflow:hidden; }
.sheet-head { position:relative; display:flex; align-items:center; justify-content:center; flex-shrink:0; height:104rpx; border-bottom:1rpx solid #edf0f4; }
.sheet-title { color:var(--ink); font-size:32rpx; font-weight:750; }
.sheet-close { position:absolute; top:22rpx; right:22rpx; width:60rpx; height:60rpx; line-height:56rpx; text-align:center; color:#65748a; font-size:42rpx; }
.filter-body { display:flex; flex:1; min-height:0; }
.filter-sidebar { flex:0 0 188rpx; width:188rpx; height:100%; background:var(--bg); }
.filter-category { box-sizing:border-box; display:flex; align-items:center; gap:8rpx; min-height:100rpx; padding:20rpx 14rpx 20rpx 22rpx; border-left:6rpx solid transparent; color:#63748b; font-size:24rpx; line-height:1.35; }
.filter-category-active { background:#fff; border-left-color:var(--accent); color:var(--accent); font-weight:700; }
.category-label { flex:1; }
.category-dot { flex-shrink:0; width:9rpx; height:9rpx; border-radius:50%; background:var(--accent); }
.filter-options { box-sizing:border-box; flex:1; min-width:0; height:100%; padding:30rpx 24rpx 40rpx; }
/* 面板右侧所有大类连成一长列，每类一个小标题 */
.filter-section { padding-bottom:40rpx; }
.filter-section + .filter-section { padding-top:8rpx; border-top:1rpx solid #edf0f4; }
.filter-section + .filter-section .options-heading { margin-top:28rpx; }
.options-heading { margin-bottom:22rpx; color:var(--ink); font-size:29rpx; font-weight:700; }
.heading-note { margin-left:12rpx; color:var(--muted); font-size:22rpx; font-weight:400; }
.option-list.option-list-3 { grid-template-columns:repeat(3,minmax(0,1fr)); }
.option-list-3 .option-chip { min-height:68rpx; font-size:23rpx; }
.option-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; }
.option-chip { box-sizing:border-box; display:flex; align-items:center; justify-content:center; min-height:82rpx; padding:12rpx 10rpx; text-align:center; background:var(--chip); color:#435268; border:1rpx solid transparent; border-radius:20rpx; font-size:24rpx; line-height:1.35; }
.option-active { color:var(--accent); background:var(--accent-soft); border-color:var(--accent); font-weight:650; }
.source-tip { margin:24rpx 0 0; color:#8190a5; font-size:22rpx; line-height:1.55; }
.sheet-actions { display:grid; grid-template-columns:210rpx 1fr; gap:18rpx; flex-shrink:0; padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e8edf2; background:#fff; }
.sheet-actions button { margin:0; border-radius:24rpx; }
.reset-button { background:#fff!important; color:var(--accent)!important; border:1rpx solid #c7dcf8; }
.apply-button { width:100%; }
.survey-overlay { position:fixed; z-index:1100; inset:0; display:flex; align-items:center; justify-content:center; padding:24rpx; box-sizing:border-box; }
.survey-mask { position:absolute; inset:0; background:rgba(15,23,42,.5); }
.survey-card { position:relative; width:100%; max-width:680rpx; max-height:90vh; display:flex; flex-direction:column; background:#fff; border-radius:36rpx; overflow:hidden; }
.survey-heading { padding:30rpx 28rpx 8rpx; text-align:center; font-size:34rpx; font-weight:700; color:var(--ink); }
.survey-scroll { height:44vh; min-height:0; }
.survey-back-row { height:42rpx; padding:0 28rpx; color:var(--accent); font-size:25rpx; }
.survey-question { margin:24rpx 28rpx 12rpx; font-size:28rpx; font-weight:650; color:var(--ink); }
.survey-wheel { height:288rpx; margin:0 28rpx; border:1rpx solid #dbe5f3; border-radius:14rpx; overflow:hidden; background:#f8faff; }
.survey-wheel-option { display:flex; align-items:center; justify-content:center; height:72rpx; color:#27364a; font-size:27rpx; text-align:center; }
.survey-wheel-selected { color:var(--accent); font-weight:650; }
.survey-selected-tags { display:flex; flex-wrap:wrap; gap:12rpx; margin:0 28rpx; }
.survey-selected-categories { margin-top:20rpx; }
.survey-selected-tags .option-chip { min-height:58rpx; padding:8rpx 14rpx; }
.survey-footer { flex-shrink:0; padding:18rpx 28rpx 26rpx; border-top:1rpx solid #edf0f4; }
.survey-optout { display:flex; align-items:center; color:#52637a; font-size:25rpx; }
.survey-optout checkbox { transform:scale(.8); transform-origin:left center; }
.survey-actions { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; margin-top:18rpx; }
.survey-actions button { margin:0; width:100%; font-size:28rpx; border-radius:24rpx; }
.survey-skip { background:var(--chip)!important; color:#52637a!important; }
.survey-complete { background:var(--accent)!important; color:#fff!important; }
