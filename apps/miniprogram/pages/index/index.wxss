.hero { background:#0c6071; color:#fff; border-radius:28rpx; padding:34rpx 28rpx 28rpx; }
.search-row { display:flex; background:#fff; border-radius:16rpx; padding:8rpx; }
.search-row input { flex:1; color:#172033; padding:10rpx 14rpx; }
.search-row button { margin:0; background:#0d8793; color:#fff; }
.filters { display:grid; grid-template-columns:1fr 1fr 1fr 1fr; margin-top:20rpx; overflow:hidden; }
.filter { text-align:center; padding:22rpx 6rpx; font-size:23rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; border-right:1rpx solid #edf0f4; }
.more-filter { border-right:0; color:#087e8b; font-weight:650; }
.filter-active { background:#e8f4f5; }
.selected-panel { margin-top:16rpx; padding:20rpx; }
.selected-head { display:flex; align-items:center; justify-content:space-between; color:#64748b; font-size:23rpx; margin-bottom:14rpx; }
.selected-list { display:flex; flex-wrap:wrap; gap:12rpx; }
.selected-chip { display:flex; align-items:center; gap:8rpx; background:#e8f4f5; color:#17626c; border:1rpx solid #badbdd; border-radius:999rpx; padding:10rpx 16rpx; font-size:23rpx; }
.chip-close { font-size:28rpx; line-height:1; color:#4c7c82; }
.result-meta { display:flex; justify-content:space-between; margin:26rpx 4rpx 16rpx; color:#64748b; font-size:25rpx; }
.clear { color:#087e8b; }
.competition { padding:24rpx; margin-bottom:18rpx; }
.card-head { display:flex; justify-content:space-between; align-items:center; }
.card-meta { display:flex; align-items:center; gap:16rpx; }
.favorite-button { display:flex; align-items:center; justify-content:center; width:52rpx; height:52rpx; color:#8190a5; font-size:40rpx; line-height:1; }
.favorite-active { color:#f59e0b; }
.status { color:#fff; background:#60748b; border-radius:999rpx; padding:7rpx 16rpx; font-size:23rpx; font-weight:650; }
.status-open { background:#087e8b; }.status-upcoming { background:#2768b2; }.status-pending { background:#7b61a8; }.status-closed { background:#7a8492; }
.verified { color:#8190a5; font-size:22rpx; }
.competition-name { font-size:32rpx; font-weight:750; line-height:1.45; margin-top:18rpx; }
.edition { color:#65748a; font-size:24rpx; margin-top:7rpx; }
.tags { display:flex; gap:10rpx; flex-wrap:wrap; margin:18rpx 0; }
.tag { background:#eff5f6; color:#36636a; border-radius:8rpx; padding:6rpx 12rpx; font-size:21rpx; }
.recommendation { display:flex; gap:12rpx; color:#164e63; font-weight:700; }
.reference { color:#8a96a8; font-weight:400; font-size:22rpx; }
.reason { color:#4c596d; font-size:24rpx; margin-top:10rpx; line-height:1.55; }
.deadline { border-top:1rpx solid #edf0f4; margin-top:18rpx; padding-top:15rpx; color:#27364a; font-size:24rpx; }
.archived-hint { color:#8a6d1f; }
.state { text-align:center; padding:70rpx 30rpx; }.state-title{font-size:32rpx;font-weight:700;margin-bottom:12rpx}.state button{margin-top:24rpx}.load-more{text-align:center;padding:20rpx}.skeleton{padding:24rpx;margin-bottom:18rpx}.skeleton view{height:24rpx;background:#edf1f4;border-radius:8rpx;margin:16rpx 0}.skeleton view:first-child{width:38%}.skeleton view:last-child{width:70%}
.filter-mask { position:fixed; z-index:1000; inset:0; background:rgba(15,23,42,.48); display:flex; align-items:flex-end; }
.filter-sheet { width:100%; height:82vh; max-height:1120rpx; background:#fff; border-radius:30rpx 30rpx 0 0; display:flex; flex-direction:column; overflow:hidden; }
.sheet-handle { width:72rpx; height:8rpx; border-radius:999rpx; background:#d8dee6; margin:16rpx auto 4rpx; }
.sheet-head { display:flex; align-items:center; justify-content:space-between; padding:16rpx 28rpx 20rpx; border-bottom:1rpx solid #edf0f4; }
.sheet-title { font-size:34rpx; font-weight:750; }
.sheet-close { width:56rpx; height:56rpx; line-height:52rpx; text-align:center; color:#718096; font-size:42rpx; }
.sheet-scroll { flex:1; min-height:0; padding:4rpx 28rpx 30rpx; box-sizing:border-box; }
.filter-group { padding-top:28rpx; }
.group-title { font-size:28rpx; font-weight:700; margin-bottom:16rpx; }
.option-list { display:flex; flex-wrap:wrap; gap:14rpx; }
.option-chip { min-width:190rpx; box-sizing:border-box; text-align:center; padding:15rpx 18rpx; background:#f3f6f8; color:#435268; border:1rpx solid transparent; border-radius:12rpx; font-size:24rpx; }
.option-active { color:#087e8b; background:#e5f3f4; border-color:#76bbc1; font-weight:650; }
.source-tip { margin:32rpx 0 14rpx; color:#8190a5; font-size:22rpx; line-height:1.55; }
.sheet-actions { display:grid; grid-template-columns:210rpx 1fr; gap:18rpx; padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e8edf2; background:#fff; }
.sheet-actions button { margin:0; }
.reset-button { background:#fff!important; color:#415166!important; border:1rpx solid #cfd8e2; }
.apply-button { width:100%; }
