<view class="page">
  <view wx:if="{{preview}}" class="preview-banner">开发预览：30场底稿尚未完成人工核验，不代表正式发布</view>
  <view class="hero">
    <text class="eyebrow">可信来源 · 状态清晰 · 推荐可解释</text>
    <view class="hero-title">找到现在值得认真了解的比赛</view>
    <view class="search-row">
      <input value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="onSearch" confirm-type="search" placeholder="赛事、别名、主办单位或关键词" />
      <button bindtap="onSearch" size="mini">搜索</button>
    </view>
  </view>

  <view class="filters card">
    <picker range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatusChange"><view class="filter">{{statusOptions[statusIndex]}}⌄</view></picker>
    <picker range="{{levelOptions}}" value="{{levelIndex}}" bindchange="onLevelChange"><view class="filter">{{levelOptions[levelIndex]}}⌄</view></picker>
    <picker range="{{professionOptions}}" value="{{professionIndex}}" bindchange="onProfessionChange"><view class="filter">{{professionOptions[professionIndex]}}⌄</view></picker>
    <view class="filter more-filter {{moreFilterCount ? 'filter-active' : ''}}" bindtap="openMoreFilters">{{moreFilterLabel}}</view>
  </view>
  <view class="selected-panel card" wx:if="{{selectedConditions.length}}">
    <view class="selected-head"><text>已选条件</text><text class="clear" bindtap="clearFilters">全部清空</text></view>
    <view class="selected-list">
      <view class="selected-chip" wx:for="{{selectedConditions}}" wx:key="kind" data-kind="{{item.kind}}" bindtap="removeCondition">
        <text>{{item.label}}</text><text class="chip-close">×</text>
      </view>
    </view>
  </view>
  <view class="result-meta"><text>找到 {{total}} 场</text><text class="clear" bindtap="clearFilters">清空条件</text></view>

  <view wx:if="{{loading && items.length === 0}}">
    <view class="skeleton card" wx:for="{{[1,2,3]}}" wx:key="*this"><view></view><view></view><view></view></view>
  </view>
  <view wx:elif="{{error}}" class="state card"><view>{{error}}</view><button bindtap="retry" size="mini">重新加载</button></view>
  <view wx:elif="{{items.length === 0}}" class="state card"><view class="state-title">没有匹配的比赛</view><view class="muted">试试清除部分筛选条件或更换关键词。</view></view>
  <view wx:else>
    <view class="competition card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="card-head">
        <text class="status {{item.statusClass}}">{{item.registrationStatus}}</text>
        <view class="card-meta">
          <text class="verified">核验 {{item.lastVerifiedDate}}</text>
          <text class="favorite-button {{item.isFavorite ? 'favorite-active' : ''}}" data-id="{{item.id}}" catchtap="toggleFavorite">{{item.isFavorite ? '★' : '☆'}}</text>
        </view>
      </view>
      <view class="competition-name">{{item.name}}</view>
      <view class="edition">{{item.editionName}}</view>
      <view class="tags"><text class="tag">{{item.eventLevel}}</text><text class="tag" wx:for="{{item.displayProfessions}}" wx:key="*this">{{item}}</text></view>
      <view class="recommendation"><text>{{item.recommendationLevel}}</text><text class="reference">仅供参考</text></view>
      <view class="reason">{{item.recommendationReasons[0]}}</view>
      <view class="deadline" wx:if="{{item.registrationEndDate}}">报名截止 {{item.registrationEndDate}}</view>
      <view class="deadline" wx:else>报名时间待官方公布</view>
    </view>
    <view class="load-more muted">{{hasMore ? (loading ? '加载中…' : '继续上拉加载') : '已显示全部结果'}}</view>
  </view>

  <view wx:if="{{morePanelVisible}}" class="filter-mask" bindtap="closeMoreFilters" catchtouchmove="blockPanelTap">
    <view class="filter-sheet" catchtap="blockPanelTap">
      <view class="sheet-handle"></view>
      <view class="sheet-head"><text class="sheet-title">更多筛选</text><text class="sheet-close" bindtap="closeMoreFilters">×</text></view>
      <scroll-view class="sheet-scroll" scroll-y>
        <view class="filter-group">
          <view class="group-title">参赛形式</view>
          <view class="option-list"><view class="option-chip {{draftParticipationFormat === item ? 'option-active' : ''}}" wx:for="{{participationFormatOptions}}" wx:key="*this" data-kind="participationFormat" data-value="{{item}}" bindtap="selectMoreOption">{{item}}</view></view>
        </view>
        <view class="filter-group">
          <view class="group-title">队伍人数</view>
          <view class="option-list"><view class="option-chip {{draftTeamSizeCategory === item ? 'option-active' : ''}}" wx:for="{{teamSizeOptions}}" wx:key="*this" data-kind="teamSizeCategory" data-value="{{item}}" bindtap="selectMoreOption">{{item}}</view></view>
        </view>
        <view class="filter-group">
          <view class="group-title">报名费用</view>
          <view class="option-list"><view class="option-chip {{draftFeeType === item ? 'option-active' : ''}}" wx:for="{{feeTypeOptions}}" wx:key="*this" data-kind="feeType" data-value="{{item}}" bindtap="selectMoreOption">{{item}}</view></view>
        </view>
        <view class="filter-group">
          <view class="group-title">报名组织方式</view>
          <view class="option-list"><view class="option-chip {{draftRegistrationOrganization === item ? 'option-active' : ''}}" wx:for="{{registrationOrganizationOptions}}" wx:key="*this" data-kind="registrationOrganization" data-value="{{item}}" bindtap="selectMoreOption">{{item}}</view></view>
        </view>
        <view class="source-tip">只展示资料明确内容；未明确的信息不会由 AI 推断。</view>
      </scroll-view>
      <view class="sheet-actions"><button class="reset-button" bindtap="resetMoreFilters">重置</button><button class="primary apply-button" bindtap="applyMoreFilters">查看{{morePreviewCount}}场赛事</button></view>
    </view>
  </view>
</view>
