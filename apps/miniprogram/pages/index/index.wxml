<import src="/templates/poster-card.wxml" />

<!-- 吸顶区：品牌栏、搜索框、筛选栏一起固定在顶部（2026-10 改版） -->
<view class="sticky-head">
  <brand-nav inline="{{true}}" />
  <view class="head-inner">
  <view class="search-line">
    <view class="search-row">
      <image class="search-icon" src="/assets/search.svg" mode="aspectFit" aria-hidden="true" />
      <input value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="onSearch" confirm-type="search" placeholder="赛事名称、主办单位或专业" />
      <button bindtap="onSearch" size="mini">搜索</button>
    </view>
    <view class="assistant-button" bindtap="openAssistant" role="button" aria-label="问问助手">
      <image src="/assets/radar.svg" mode="aspectFit" aria-hidden="true" /><text>助手</text>
    </view>
  </view>

  <view class="filter-panel">
    <view class="quick-chip all-filter-chip {{region || preferenceProvince || competitionCategories.length || professionIndex || statusIndex ? '' : 'quick-chip-active'}}" bindtap="onComprehensiveTap" role="button" aria-label="全部，清除地区、专业大类和报名状态，保留搜索及其他筛选">全部</view>
    <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-track">
        <picker class="quick-picker" range="{{regionOptions}}" value="{{regionIndex}}" bindchange="onRegionChange">
          <view class="quick-chip {{region ? 'quick-chip-active' : ''}}">{{region || '地区'}}<text class="chip-arrow">⌄</text></view>
        </picker>
        <picker class="quick-picker" range="{{professionOptions}}" value="{{professionIndex}}" bindchange="onProfessionChange">
          <view class="quick-chip {{competitionCategories.length ? 'quick-chip-active' : ''}}">{{competitionCategories.length > 1 ? '专业大类（' + competitionCategories.length + '）' : professionIndex ? professionOptions[professionIndex] : '专业大类'}}<text class="chip-arrow">⌄</text></view>
        </picker>
        <picker class="quick-picker" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatusChange">
          <view class="quick-chip {{statusIndex ? 'quick-chip-active' : ''}}">{{statusIndex ? statusOptions[statusIndex] : '报名状态'}}<text class="chip-arrow">⌄</text></view>
        </picker>
      </view>
    </scroll-view>
    <view class="filter-trigger {{moreFilterCount ? 'filter-trigger-active' : ''}}" bindtap="openMoreFilters" role="button" aria-label="其他筛选">
      <image src="/assets/filter.svg" mode="aspectFit" aria-hidden="true" />
      <text wx:if="{{moreFilterCount}}" class="filter-count">{{moreFilterCount}}</text>
    </view>
  </view>
  </view>
</view>
<view class="page">
  <view class="result-meta"><text>找到 {{total}} 场</text></view>

  <view wx:if="{{loading && items.length === 0}}" class="skeleton-grid">
    <view class="skeleton card" wx:for="{{[1,2,3,4]}}" wx:key="*this"><view class="skeleton-poster"></view><view></view><view></view><view></view></view>
  </view>
  <view wx:elif="{{error}}" class="state card"><view>{{error}}</view><button bindtap="retry" size="mini">重新加载</button></view>
  <view wx:elif="{{items.length === 0}}" class="state card">
    <view class="state-title">没有匹配的比赛</view><view class="muted">试试清除部分筛选条件或更换关键词。</view>
    <view class="suggest"><text class="suggest-chip" wx:for="{{suggestKeywords}}" wx:key="*this" data-keyword="{{item}}" bindtap="searchSuggestion">{{item}}</text></view>
  </view>
  <view wx:else>
    <!-- 双列卡片（2026-10 淘宝风格改版）：海报或文字封面 + 报名状态、级别、推荐等级 + 截止倒计时；每行两张顶部对齐、一样高（用户定，不要错落） -->
    <view class="card-grid">
      <template is="poster-card" wx:for="{{items}}" wx:key="id" data="{{item, index}}" />
    </view>
    <view class="load-more muted">{{hasMore ? (loading ? '加载中…' : '继续上拉加载') : '已显示全部结果'}}</view>
  </view>

  <view wx:if="{{surveyVisible}}" class="survey-overlay">
    <view class="survey-mask" catchtouchmove="blockPanelTap" catchtap="blockPanelTap"></view>
    <view class="survey-card" role="dialog" aria-label="找到适合你的比赛">
      <view class="survey-heading">找到适合你的比赛</view>
      <view class="survey-back-row"><text wx:if="{{surveyStep > 0}}" bindtap="previousPreferenceSurveyStep">‹ 上一步</text></view>
      <scroll-view class="survey-scroll" scroll-y>
        <block wx:if="{{surveyStep === 0}}">
        <view class="survey-question">你所在的地区是哪里？</view>
        <picker-view class="survey-wheel" value="{{[surveyProvinceIndex]}}" bindchange="onSurveyProvinceChange" indicator-style="height:72rpx;" aria-label="上下滑动选择地区">
          <picker-view-column><view class="survey-wheel-option" wx:for="{{surveyProvinceOptions}}" wx:key="*this">{{item}}</view></picker-view-column>
        </picker-view>
        </block>
        <block wx:else>
        <view class="survey-question">你想参加哪些专业大类的比赛？（可多选）</view>
        <picker-view class="survey-wheel" value="{{surveyCategoryWheelIndex}}" bindchange="onSurveyCategoryChange" indicator-style="height:72rpx;" aria-label="上下滑动选择专业大类">
          <picker-view-column><view class="survey-wheel-option {{item.selected ? 'survey-wheel-selected' : ''}}" wx:for="{{surveyCategoryOptions}}" wx:key="label" data-value="{{item.value}}" bindtap="selectSurveyCategory">{{item.label}}{{item.selected ? ' ✓' : ''}}</view></picker-view-column>
        </picker-view>
        <view class="survey-selected-categories" wx:if="{{surveyCategories.length}}">
          <view class="survey-selected-tags"><view class="option-chip option-active" wx:for="{{surveyCategories}}" wx:key="*this" data-value="{{item}}" bindtap="selectSurveyCategory">{{item}} ×</view></view>
        </view>
        </block>
      </scroll-view>
      <view class="survey-footer">
        <checkbox-group bindchange="onSurveyDontShowAgainChange"><label class="survey-optout"><checkbox value="hide" checked="{{surveyDontShowAgain}}" color="#1765d9" /><text>不再显示此弹窗</text></label></checkbox-group>
        <view class="survey-actions"><button class="survey-skip" bindtap="skipPreferenceSurvey">跳过调查</button><button class="survey-complete" bindtap="confirmPreferenceSurveyStep">{{surveyStep < 1 ? '确定，下一步' : '确定，完成'}}</button></view>
      </view>
    </view>
  </view>

  <view wx:if="{{morePanelVisible}}" class="filter-mask" bindtap="closeMoreFilters">
    <view class="filter-sheet" catchtap="blockPanelTap">
      <view class="sheet-head"><text class="sheet-title">全部筛选</text><text class="sheet-close" bindtap="closeMoreFilters" role="button" aria-label="关闭筛选">×</text></view>
      <view class="filter-body">
        <scroll-view class="filter-sidebar" scroll-y>
          <view class="filter-category {{activeFilterCategoryIndex === index ? 'filter-category-active' : ''}}" wx:for="{{filterCategories}}" wx:key="*this" data-index="{{index}}" bindtap="selectFilterCategory">
            <text class="category-label">{{item}}</text>
            <text class="category-dot" wx:if="{{(index === 0 && draftParticipationFormat) || (index === 1 && draftTeamSizeCategory) || (index === 2 && draftFeeType) || (index === 3 && draftRegistrationOrganization) || (index === 4 && draftEventLevel) || (index === 5 && draftRegistrationWithin) || (index === 6 && (draftSortBy || draftSortOrder))}}"></text>
          </view>
        </scroll-view>
        <scroll-view class="filter-options" scroll-y>
          <view class="options-heading">{{filterCategories[activeFilterCategoryIndex]}}</view>
          <block wx:if="{{activeFilterCategoryIndex === 0}}">
            <view class="option-list"><view class="option-chip {{draftParticipationFormat === item ? 'option-active' : ''}}" wx:for="{{participationFormatOptions}}" wx:key="*this" data-kind="participationFormat" data-value="{{item}}" bindtap="selectMoreOption">{{item}}</view></view>
          </block>
          <block wx:elif="{{activeFilterCategoryIndex === 1}}">
            <view class="option-list"><view class="option-chip {{draftTeamSizeCategory === item ? 'option-active' : ''}}" wx:for="{{teamSizeOptions}}" wx:key="*this" data-kind="teamSizeCategory" data-value="{{item}}" bindtap="selectMoreOption">{{item}}</view></view>
          </block>
          <block wx:elif="{{activeFilterCategoryIndex === 2}}">
            <view class="option-list"><view class="option-chip {{draftFeeType === item ? 'option-active' : ''}}" wx:for="{{feeTypeOptions}}" wx:key="*this" data-kind="feeType" data-value="{{item}}" bindtap="selectMoreOption">{{item}}</view></view>
          </block>
          <block wx:elif="{{activeFilterCategoryIndex === 3}}">
            <view class="option-list"><view class="option-chip {{draftRegistrationOrganization === item ? 'option-active' : ''}}" wx:for="{{registrationOrganizationOptions}}" wx:key="*this" data-kind="registrationOrganization" data-value="{{item}}" bindtap="selectMoreOption">{{item}}</view></view>
          </block>
          <block wx:elif="{{activeFilterCategoryIndex === 4}}">
            <view class="option-list"><view class="option-chip {{((index === 0 && !draftEventLevel) || draftEventLevel === item) ? 'option-active' : ''}}" wx:for="{{levelOptions}}" wx:key="*this" data-kind="eventLevel" data-value="{{index === 0 ? '' : item}}" bindtap="selectMoreOption">{{item}}</view></view>
          </block>
          <block wx:elif="{{activeFilterCategoryIndex === 5}}">
            <view class="option-list"><view class="option-chip {{draftRegistrationWithin === registrationWithinValues[index] ? 'option-active' : ''}}" wx:for="{{registrationWithinOptions}}" wx:key="*this" wx:for-index="index" data-kind="registrationWithin" data-value="{{registrationWithinValues[index]}}" bindtap="selectMoreOption">{{item}}</view></view>
            <view class="source-tip">“已截止”的赛事若已经归档，可按推算的下一届时间查找。</view>
          </block>
          <block wx:elif="{{activeFilterCategoryIndex === 6}}">
            <view class="option-subheading">排序依据</view>
            <view class="option-list"><view class="option-chip {{draftSortBy === sortByValues[index] ? 'option-active' : ''}}" wx:for="{{sortByOptions}}" wx:key="*this" wx:for-index="index" data-kind="sortBy" data-value="{{sortByValues[index]}}" bindtap="selectMoreOption">{{item}}</view></view>
            <view class="option-subheading secondary-heading">时间顺序</view>
            <view class="option-list"><view class="option-chip {{draftSortOrder === sortOrderValues[index] ? 'option-active' : ''}}" wx:for="{{sortOrderOptions}}" wx:key="*this" wx:for-index="index" data-kind="sortOrder" data-value="{{sortOrderValues[index]}}" bindtap="selectMoreOption">{{item}}</view></view>
          </block>
        </scroll-view>
      </view>
      <view class="sheet-actions"><button class="reset-button" bindtap="resetMoreFilters">清空选择</button><button class="primary apply-button" bindtap="applyMoreFilters">确定 · {{morePreviewCount}}场赛事</button></view>
    </view>
  </view>
</view>
