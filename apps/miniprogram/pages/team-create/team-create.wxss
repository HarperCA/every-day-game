@import "/templates/profile-sheet.wxss";
/* 创建队伍（2026-11-05）。颜色变量见 app.wxss */
.tc-page { min-height: 100vh; padding: 24rpx 24rpx calc(150rpx + env(safe-area-inset-bottom)); box-sizing: border-box; display: flex; flex-direction: column; gap: 24rpx; }
.tc-sec { background: var(--surface); border-radius: 32rpx; padding: 28rpx 32rpx; }
.tc-label { font-size: 26rpx; font-weight: 600; color: var(--ink2); }
.tc-label-next { margin-top: 24rpx; }
.tc-comp-row { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; min-height: 56rpx; }
.tc-comp { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 600; line-height: 1.5; word-break: break-all; }
.tc-comp-empty { font-weight: 400; color: var(--accent); }
.tc-chev { flex: none; color: var(--muted); font-size: 36rpx; line-height: 1; }
.tc-input { margin-top: 10rpx; height: 72rpx; font-size: 30rpx; }
.tc-picker { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; height: 72rpx; font-size: 30rpx; }
.tc-line { margin-top: 12rpx; height: 1rpx; background: var(--line); }
.tc-holder { color: var(--muted); }
.tc-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--line); }
.tc-submit { margin: 0; width: 100%; height: 88rpx; line-height: 88rpx; padding: 0; border-radius: 24rpx; background: var(--accent); color: #fff; font-size: 30rpx; font-weight: 600; }
.tc-submit::after { border: 0; }
