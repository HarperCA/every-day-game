<view class="page">
  <view class="notice">纠错内容会进入管理员审核，不会由 AI 自动改写赛事信息。</view>
  <view class="card">
    <view wx:if="{{lockedCompetition}}" class="competition"><text>纠错赛事</text><strong>{{competitionName}}</strong></view>
    <label wx:else class="field">
      <text>纠错赛事 <i>必填</i></text>
      <picker wx:if="{{competitions.length}}" mode="selector" range="{{competitions}}" range-key="label" value="{{competitionIndex}}" bindchange="onCompetitionChange">
        <view class="picker">{{competitionIndex >= 0 ? competitionName : '请选择赛事'}} <text>›</text></view>
      </picker>
      <view wx:else class="picker picker-empty">{{competitionsLoading ? '正在加载赛事列表…' : '暂无可选赛事'}}</view>
    </label>
    <label class="field">
      <text>问题类型</text>
      <picker mode="selector" range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker">{{categories[categoryIndex].label}} <text>›</text></view>
      </picker>
    </label>
    <label class="field">
      <text>问题说明 <i>必填</i></text>
      <textarea maxlength="2000" value="{{content}}" bindinput="onContentInput" placeholder="请说明哪里有误，以及你认为正确的信息。不要填写身份证号、密码等敏感信息。" />
      <small>{{content.length}} / 2000</small>
    </label>
    <label class="field">
      <text>证据链接 <i>选填</i></text>
      <input type="text" value="{{evidenceUrl}}" bindinput="onEvidenceInput" placeholder="https:// 主办方通知或官网页面" />
    </label>
  </view>
  <button class="submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在提交…' : '提交纠错'}}</button>

  <view class="records card">
    <view class="records-head">我的纠错<text wx:if="{{records.length}}">{{records.length}} 条</text></view>
    <view wx:if="{{recordsHint}}" class="records-empty">{{recordsHint}}</view>
    <view wx:elif="{{recordsLoading && !records.length}}" class="records-empty">正在加载…</view>
    <view wx:elif="{{!records.length}}" class="records-empty">你还没有提交过纠错。</view>
    <view wx:else>
      <view wx:for="{{records}}" wx:key="id" class="record">
        <view class="record-top">
          <strong>{{item.competitionName}}</strong>
          <text class="status status-{{item.statusValue}}">{{item.statusLabel}}</text>
        </view>
        <view class="record-meta">{{item.categoryLabel}} · {{item.createdAt}}</view>
        <view class="record-content">{{item.content}}</view>
      </view>
    </view>
  </view>
</view>
