.page { min-height:100vh; box-sizing:border-box; padding:24rpx; background:#f4f7fc; color:#172033; }
.card { padding:30rpx; border-radius:24rpx; background:#fff; box-shadow:0 8rpx 28rpx rgba(31,45,61,.06); }
.competition { padding-bottom:26rpx; border-bottom:1rpx solid #edf0f4; }
.competition text, .field > text { display:block; margin-bottom:12rpx; color:#64748b; font-size:25rpx; }
.competition strong { font-size:31rpx; line-height:1.5; }
.field { display:block; margin-top:28rpx; }
.field i { color:#1765d9; font-style:normal; }
.picker, input, textarea { box-sizing:border-box; width:100%; border:1rpx solid #dce3ea; border-radius:15rpx; background:#fbfcfd; font-size:28rpx; }
.picker, input { min-height:84rpx; padding:22rpx; }
.picker { display:flex; justify-content:space-between; }
textarea { height:260rpx; padding:22rpx; line-height:1.6; }
.field small { display:block; margin-top:8rpx; color:#94a3b8; text-align:right; font-size:22rpx; }
.submit { margin-top:30rpx; border-radius:18rpx; background:#1765d9; color:#fff; font-weight:700; }
.picker-empty { color:#94a3b8; }
.records { margin-top:30rpx; }
.records-head { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:8rpx; font-size:29rpx; font-weight:700; }
.records-head text { color:#94a3b8; font-size:24rpx; font-weight:400; }
.records-empty { padding:24rpx 0; color:#94a3b8; font-size:26rpx; line-height:1.6; }
.record { padding:24rpx 0; border-bottom:1rpx solid #edf0f4; }
.record:last-child { border-bottom:none; padding-bottom:0; }
.record-top { display:flex; justify-content:space-between; align-items:flex-start; gap:16rpx; }
.record-top strong { flex:1; font-size:28rpx; line-height:1.5; }
.status { flex-shrink:0; padding:4rpx 14rpx; border-radius:999rpx; background:#eef2f6; color:#64748b; font-size:22rpx; }
.status-accepted { background:#e6f6ef; color:#1a7f52; }
.status-rejected { background:#fdecea; color:#b3261e; }
.status-human_reviewing { background:#fff4e5; color:#a85b00; }
.record-meta { margin-top:8rpx; color:#94a3b8; font-size:23rpx; }
.record-content { margin-top:10rpx; color:#475569; font-size:26rpx; line-height:1.6; }
