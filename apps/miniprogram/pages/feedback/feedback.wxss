/* 信息纠错（2026-10 改版）：铺满式。颜色变量见 app.wxss */
.fb-page { min-height: 100vh; padding-bottom: 64rpx; box-sizing: border-box; }
.gh { display: flex; justify-content: space-between; padding: 32rpx 32rpx 12rpx; font-size: 25rpx; color: var(--muted); }
.req { color: var(--accent); }
.opt { color: var(--muted); }
.grp { background: var(--surface); border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); }
.cell { position: relative; display: flex; align-items: center; gap: 24rpx; min-height: 100rpx; padding: 0 32rpx; font-size: 32rpx; }
.cell-line::before { content: ""; position: absolute; top: 0; left: 32rpx; right: 0; height: 1rpx; background: var(--line); }
.k { flex: none; min-width: 144rpx; white-space: nowrap; }
.v { flex: 1; min-width: 0; text-align: right; color: var(--ink2); font-size: 30rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.v.ph, .ph-text { color: var(--muted); }
.chev { flex: none; color: var(--muted); font-size: 36rpx; line-height: 1; }
.inp { flex: 1; min-width: 0; text-align: right; font-size: 30rpx; }
.ta { padding: 24rpx 32rpx 16rpx; }
.ta textarea { width: 100%; height: 240rpx; font-size: 30rpx; line-height: 1.6; }
.count { text-align: right; font-size: 23rpx; color: var(--muted); }
.submit { margin: 44rpx 32rpx 0; height: 92rpx; line-height: 92rpx; border-radius: 16rpx; background: var(--accent); color: #fff; font-size: 32rpx; font-weight: 600; }
.submit::after { border: 0; }
.submit[disabled] { opacity: .6; }
.hint { padding: 16rpx 32rpx 0; font-size: 25rpx; color: var(--muted); line-height: 1.6; }
.empty { padding: 32rpx; font-size: 27rpx; color: var(--muted); line-height: 1.6; }
.rec { position: relative; padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 4rpx; }
.rec + .rec::before { content: ""; position: absolute; top: 0; left: 32rpx; right: 0; height: 1rpx; background: var(--line); }
.rtop { display: flex; align-items: baseline; gap: 20rpx; }
.rname { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rs { flex: none; font-size: 26rpx; font-weight: 600; }
.rs.ok { color: #1a7f52; } .rs.no { color: #b3261e; } .rs.ing { color: var(--amber); } .rs.wait { color: var(--muted); }
.rmeta { font-size: 25rpx; color: var(--muted); }
.rbody { font-size: 27rpx; color: var(--ink2); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
