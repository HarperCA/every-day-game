/* 组队申请（2026-11-05）。颜色变量见 app.wxss */
.ta-page { min-height: 100vh; padding: 20rpx 24rpx 48rpx; box-sizing: border-box; }
.ta-tabs { display: flex; padding: 6rpx; margin-bottom: 20rpx; border-radius: 20rpx; background: var(--chip); }
.ta-tab { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; height: 68rpx; border-radius: 16rpx; font-size: 27rpx; color: var(--ink2); }
.ta-tab.on { background: var(--surface); color: var(--accent); font-weight: 700; }
.ta-badge { min-width: 32rpx; height: 32rpx; line-height: 32rpx; padding: 0 8rpx; box-sizing: border-box; border-radius: 16rpx; background: #e5484d; color: #fff; text-align: center; font-size: 20rpx; font-weight: 600; }
.ta-count { font-size: 24rpx; color: var(--muted); }
.ta-empty { padding-top: 160rpx; text-align: center; font-size: 28rpx; color: var(--muted); }
.ta-card { background: var(--surface); border-radius: 28rpx; padding: 26rpx 28rpx; margin-bottom: 20rpx; }
.ta-person { display: flex; align-items: flex-start; gap: 18rpx; }
.ta-ava { flex: none; width: 72rpx; height: 72rpx; line-height: 72rpx; border-radius: 50%; background: var(--accent-soft); color: var(--accent); text-align: center; font-size: 30rpx; font-weight: 600; }
.ta-person-text { flex: 1; min-width: 0; }
.ta-name-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4rpx 12rpx; }
.ta-name { font-size: 30rpx; font-weight: 600; line-height: 1.45; word-break: break-all; }
.ta-major { font-size: 24rpx; color: var(--muted); }
.ta-sub { margin-top: 4rpx; font-size: 25rpx; line-height: 1.5; color: var(--ink2); word-break: break-all; }
.ta-message { margin-top: 16rpx; padding: 14rpx 20rpx; border-radius: 16rpx; background: var(--bg); font-size: 26rpx; line-height: 1.6; color: var(--ink2); word-break: break-all; }
.ta-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 18rpx; }
.ta-btn { margin: 0; width: 172rpx; height: 64rpx; line-height: 62rpx; padding: 0; border-radius: 32rpx; font-size: 26rpx; font-weight: 600; }
.ta-btn::after { border: 0; }
.ta-btn-plain { background: var(--surface); color: var(--ink2); border: 1rpx solid var(--line); }
.ta-btn-main { background: var(--accent); color: #fff; border: 1rpx solid var(--accent); }
.ta-out-r1 { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.ta-out-name { flex: 1; min-width: 0; }
.ta-status { flex: none; padding: 2rpx 14rpx; border-radius: 10rpx; font-size: 22rpx; line-height: 1.6; font-weight: 500; white-space: nowrap; }
.status-wait { background: #fdf3e4; color: var(--amber); }
.status-plain { background: var(--chip); color: var(--ink2); }
.ta-ava-img { display: block; }
.ta-line { margin-top: 14rpx; }
