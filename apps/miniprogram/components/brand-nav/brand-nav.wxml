<view class="brand-nav {{inline ? 'brand-nav-inline' : ''}}" style="padding-top:{{statusBarHeight}}px">
  <view class="brand-nav-bar" style="height:{{navBarHeight}}px">
    <image class="brand-nav-logo" src="/assets/competition-radar-logo.svg" mode="aspectFit" aria-hidden="true" />
    <text class="brand-nav-title">竞赛雷达</text>
  </view>
</view>
<!-- 标题栏固定在顶部，这块空白把页面内容往下推，避免被盖住；inline 时由页面自己排版，不需要 -->
<view wx:if="{{!inline}}" style="height:{{statusBarHeight + navBarHeight}}px"></view>
