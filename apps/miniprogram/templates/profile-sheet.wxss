/* 昵称头像小面板（2026-11-12），模板见 profile-sheet.wxml。颜色变量见 app.wxss */
.ps-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(15, 23, 42, .45); }
.ps-panel { width: 100%; box-sizing: border-box; padding: 40rpx 40rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: var(--surface); display: flex; flex-direction: column; align-items: center; }
.ps-title { font-size: 34rpx; font-weight: 700; }
.ps-sub { margin-top: 8rpx; font-size: 26rpx; color: var(--muted); }
.ps-ava-btn { margin: 32rpx 0 0; padding: 0; width: 144rpx; height: 144rpx; border-radius: 50%; background: transparent; line-height: 1; }
.ps-ava-btn::after { border: 0; }
.ps-ava { display: block; width: 144rpx; height: 144rpx; border-radius: 50%; }
.ps-ava-empty { display: flex; align-items: center; justify-content: center; background: var(--accent-soft); color: var(--accent); font-size: 26rpx; font-weight: 600; }
.ps-input { box-sizing: border-box; width: 100%; height: 88rpx; margin-top: 32rpx; padding: 0 24rpx; border-radius: 20rpx; background: var(--chip); font-size: 30rpx; text-align: center; }
.ps-holder { color: var(--muted); }
.ps-actions { display: flex; gap: 20rpx; width: 100%; margin-top: 36rpx; }
.ps-btn { flex: 1; margin: 0; padding: 0; height: 84rpx; line-height: 84rpx; border-radius: 24rpx; font-size: 30rpx; font-weight: 600; }
.ps-btn::after { border: 0; }
.ps-btn-plain { background: var(--chip); color: var(--ink2); }
.ps-btn-main { background: var(--accent); color: #fff; }
